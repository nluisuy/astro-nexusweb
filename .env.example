# Email (contact / POC form)
# ==========================
# Resend API key (https://resend.com/api-keys), "Sending access" only.
# The domain used in MAIL_FROM must be verified at https://resend.com/domains
RESEND_API_KEY=
MAIL_FROM="Nexus Innovations <hello@nexusinnova.com>"
MAIL_TO=hello@nexusinnova.com

# "Let's Talk" button
# ===================
# Public booking page (Calendly, cal.com, Google Calendar appointment...).
# When set, the navbar CTA opens it in a new tab; when empty, it opens the contact modal.
PUBLIC_BOOKING_URL=
