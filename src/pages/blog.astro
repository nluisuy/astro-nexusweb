---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Projects from "../components/Projects.astro";
import InsightsFeed from "../components/InsightsFeed.astro";

const pageTitle = "Insights — Nexus Digital Innovations";
const pageDescription = "Expert perspectives on Enterprise AI, Agentic Systems, Cloud Architecture, and Cybersecurity. Thought leadership from the Nexus team.";

interface BlogPost {
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    categoryColor: string;
    date: string;
    readTime: string;
}

const posts: BlogPost[] = [
    {
        slug: "agentic-ai-vs-traditional-automation",
        title: "Agentic AI vs Traditional Automation: What Enterprise Leaders Need to Know",
        excerpt: "The shift from rule-based automation to autonomous AI agents is reshaping how enterprises operate. We break down the key differences, use cases, and ROI implications.",
        category: "AI Strategy",
        categoryColor: "text-nexus-red bg-nexus-red/10",
        date: "March 2026",
        readTime: "8 min read",
    },
    {
        slug: "building-first-ai-agent-pipeline",
        title: "Building Your First AI Agent Pipeline: A CTO's Guide",
        excerpt: "A practical, no-hype walkthrough of designing and deploying your first production-grade AI agent — from orchestration layer to knowledge base integration.",
        category: "Engineering",
        categoryColor: "text-nexus-blue bg-nexus-blue/10",
        date: "March 2026",
        readTime: "12 min read",
    },
    {
        slug: "ai-dev-pods-future-software-teams",
        title: "AI Dev Pods: The Future of Software Teams",
        excerpt: "How dedicated development squads powered by Agentic AI are accelerating product innovation, reducing cycle times, and redefining what a 'team' means.",
        category: "Innovation",
        categoryColor: "text-orange-500 bg-orange-500/10",
        date: "February 2026",
        readTime: "6 min read",
    },
    {
        slug: "enterprise-rag-architecture-guide",
        title: "Enterprise RAG Architecture: From POC to Production",
        excerpt: "Retrieval-Augmented Generation is the backbone of enterprise AI. Learn how to architect RAG systems that are accurate, scalable, and secure.",
        category: "Architecture",
        categoryColor: "text-nexus-purple bg-nexus-purple/10",
        date: "February 2026",
        readTime: "10 min read",
    },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-clip">
        <Navbar />

        <main>
            <InsightsFeed
                posts={posts}
                kicker="Insights"
                title="Thought leadership, from the field."
                lead="Expert perspectives on enterprise AI, agentic systems, cloud architecture and cybersecurity — written by the people who ship them."
                soon="Coming soon"
                nlTitle="Stay ahead of the curve."
                nlDesc="Our latest insights on enterprise AI, security and cloud architecture, once a month."
                nlPlaceholder="your@email.com"
                nlBtn="Subscribe"
            />
        </main>

        <!-- Case studies (shared with the home page) -->
        <Projects />

        <Footer />
    </div>
</Layout>
