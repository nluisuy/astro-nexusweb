---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import VerticalsDeck from "../components/VerticalsDeck.astro";
import Services from "../components/Services.astro";
import MiniCTA from "../components/MiniCTA.astro";
import Projects from "../components/Projects.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import AIProjectPlanner from "../components/AIProjectPlanner";
import Stats from "../components/Stats.astro";
import Bookingsession from "../components/Bookingsession.astro";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

// SEO-optimized metadata for homepage
const pageTitle = "Nexus Digital Innovations — Enterprise AI Agents, Cloud & Cybersecurity";
const pageDescription =
    "We architect autonomous AI agent systems, AI Dev Pods, secure cloud infrastructure, and cybersecurity solutions that transform how enterprises build, scale, and innovate.";
---

<Layout title={pageTitle} description={pageDescription}>
    <!-- overflow-x-clip (not hidden): keeps the deck's sticky stage working -->
    <div class="relative min-h-screen overflow-x-clip">
        <Navbar />

        <main>
            <VerticalsDeck />
            <Services />
            <MiniCTA />
            <Stats />
            <Projects />
            <About />
            <Bookingsession />
        </main>

        <Footer />

        <!-- Modal container for AIProjectPlanner -->
        <div id="planner-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-end">
            <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm">
            </div>
            <div
                class="relative w-full max-w-2xl h-full bg-white shadow-2xl animate-in slide-in-from-right duration-500"
            >
                <AIProjectPlanner client:only="react" isOpen={true} onClose={() => {}} lang={lang} />
            </div>
        </div>

    </div>
</Layout>

<script>
    // Simple functions to control modal visibility with CSS
    function openPlanner() {
        const modal = document.getElementById("planner-modal");
        if (modal) {
            modal.classList.remove("hidden");
        }
    }

    function closePlanner() {
        const modal = document.getElementById("planner-modal");
        if (modal) {
            modal.classList.add("hidden");
        }
    }

    // Set up event listeners when DOM is ready
    document.addEventListener("DOMContentLoaded", () => {
        const heroBtn = document.getElementById("hero-planner-btn");
        if (heroBtn) {
            heroBtn.addEventListener("click", openPlanner);
        }

        const backdrop = document.getElementById("modal-backdrop");
        if (backdrop) {
            backdrop.addEventListener("click", closePlanner);
        }

        // Custom event listener for opening planner from other components
        window.addEventListener("openPlanner", () => openPlanner());
    });

    // Make closePlanner available globally so the React planner can call it
    (window as any).closePlanner = closePlanner;
</script>
