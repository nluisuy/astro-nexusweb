---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Projects from "../../components/Projects.astro";
import InsightsFeed from "../../components/InsightsFeed.astro";

const pageTitle = "Ideas y Perspectivas — Nexus Digital Innovations";
const pageDescription = "Perspectivas de expertos sobre IA Empresarial, Sistemas de Agentes, Arquitectura Cloud y Ciberseguridad. Liderazgo intelectual del equipo de Nexus.";

interface BlogPost {
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    categoryColor: string;
    date: string;
    readTime: string;
}

const posts: BlogPost[] = [
    {
        slug: "agentic-ai-vs-traditional-automation",
        title: "IA Agéntica vs Automatización Tradicional: Lo que los Líderes Empresariales Deben Saber",
        excerpt: "El cambio de la automatización basada en reglas a los agentes de IA autónomos está remodelando cómo operan las empresas. Desglosamos las diferencias clave, casos de uso y las implicaciones en el ROI.",
        category: "Estrategia IA",
        categoryColor: "text-nexus-red bg-nexus-red/10",
        date: "Marzo 2026",
        readTime: "8 min de lectura",
    },
    {
        slug: "building-first-ai-agent-pipeline",
        title: "Construyendo tu Primer Pipeline de Agente de IA: Guía para CTOs",
        excerpt: "Un recorrido práctico para diseñar y desplegar tu primer agente de IA a nivel de producción — desde la capa de orquestación hasta la integración de la base de conocimientos.",
        category: "Ingeniería",
        categoryColor: "text-nexus-blue bg-nexus-blue/10",
        date: "Marzo 2026",
        readTime: "12 min de lectura",
    },
    {
        slug: "ai-dev-pods-future-software-teams",
        title: "AI Dev Pods: El Futuro de los Equipos de Software",
        excerpt: "Cómo los escuadrones de desarrollo dedicados impulsados por IA Agéntica están acelerando la innovación de productos, reduciendo tiempos de ciclo y redefiniendo lo que significa un 'equipo'.",
        category: "Innovación",
        categoryColor: "text-orange-500 bg-orange-500/10",
        date: "Febrero 2026",
        readTime: "6 min de lectura",
    },
    {
        slug: "enterprise-rag-architecture-guide",
        title: "Arquitectura RAG Empresarial: De un POC a Producción",
        excerpt: "La Generación Aumentada por Recuperación (RAG) es la columna vertebral de la IA empresarial. Aprende a diseñar sistemas RAG que sean precisos, escalables y seguros.",
        category: "Arquitectura",
        categoryColor: "text-nexus-purple bg-nexus-purple/10",
        date: "Febrero 2026",
        readTime: "10 min de lectura",
    },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-clip">
        <Navbar />

        <main>
            <InsightsFeed
                posts={posts}
                kicker="Ideas y perspectivas"
                title="Liderazgo intelectual, desde el terreno."
                lead="Perspectivas de expertos sobre IA empresarial, sistemas de agentes, arquitectura cloud y ciberseguridad — escritas por quienes las construyen."
                soon="Próximamente"
                nlTitle="Mantente a la vanguardia."
                nlDesc="Nuestras últimas perspectivas sobre IA empresarial, seguridad y arquitectura cloud, una vez al mes."
                nlPlaceholder="tu@correo.com"
                nlBtn="Suscribirse"
            />
        </main>

        <!-- Casos de éxito (compartidos con la home) -->
        <Projects />

        <Footer />
    </div>
</Layout>
