---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";

const pageTitle = "Nuestro Manifiesto";
const pageDescription = "El manifiesto de Nexus Digital Innovations — nuestros principios para construir el futuro de la tecnología empresarial con precisión, innovación e integridad.";

const principles = [
    { icon: "architecture", title: "Precisión antes que velocidad", desc: "No nos apresuramos al lanzar. Diseñamos con intención, construyendo sistemas que escalan elegantemente y superan la prueba de la demanda empresarial." },
    { icon: "shield_with_house", title: "La seguridad es la base", desc: "La seguridad no es una adición tardía. Está integrada en cada decisión, cada despliegue, cada interacción." },
    { icon: "neurology", title: "IA con propósito", desc: "Aprovechamos la IA generativa no porque esté de moda, sino porque desbloquea valor real con un ROI medible." },
    { icon: "handshake", title: "Asociación, no proveedores", desc: "No vendemos servicios — invertimos en resultados. El éxito de nuestros clientes es nuestro éxito." },
    { icon: "rocket_launch", title: "Innovación imparable", desc: "El entorno tecnológico nunca se detiene, y nosotros tampoco. Evolucionamos constantemente nuestras metodologías." },
    { icon: "visibility", title: "Transparencia radical", desc: "Sin cajas negras. Sin agendas ocultas. Nos comunicamos abiertamente sobre plazos, desafíos y compromisos." },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-clip">
        <Navbar />

        <main>
            <PageHero
                kicker="Nuestro manifiesto"
                title="Construimos lo que"
                accent="importa."
                lead="En un mundo inundado de ruido, elegimos la sustancia. Cada línea de arquitectura, cada protocolo de seguridad, cada modelo de IA que desplegamos existe para crear un impacto duradero."
            />

            <section class="relative pb-24 lg:pb-32">
                <div class="max-w-7xl mx-auto px-6 lg:px-12">
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
                        {
                            principles.map((p) => (
                                <div class="nx-glass nx-glass--hover reveal p-6">
                                    <span class="nx-icon-tile mb-4">
                                        <span class="material-symbols-outlined text-[1.25rem]">{p.icon}</span>
                                    </span>
                                    <h3 class="font-display font-bold text-slate-900 dark:text-white text-[1.08rem] tracking-tight mb-2">{p.title}</h3>
                                    <p class="text-[0.88rem] leading-relaxed text-slate-500 dark:text-slate-400 font-light">{p.desc}</p>
                                </div>
                            ))
                        }
                    </div>

                    <div class="relative nx-glass reveal p-8 md:p-12 overflow-hidden">
                        <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
                        <div class="nx-kicker mb-5">Por qué existimos</div>
                        <blockquote class="font-display font-extrabold tracking-[-0.03em] leading-[1.1] text-2xl md:text-[2.1rem] text-slate-900 dark:text-white max-w-3xl mb-8">
                            Existimos en la intersección de la visión y la ejecución técnica refinada — donde cada solución se diseña para definir nuevos estándares de excelencia digital.
                        </blockquote>
                        <a href="/es/#contact" class="nx-cta">
                            Iniciar la conversación
                            <span class="material-symbols-outlined text-lg">arrow_right_alt</span>
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
    </div>
</Layout>
