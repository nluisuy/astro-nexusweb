---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const pageTitle = "Carreras en Nexus";
const pageDescription = "Únete a Nexus Digital Innovations — buscamos arquitectos, estrategas e innovadores que prosperen construyendo soluciones digitales de grado empresarial.";

const values = [
    { icon: "neurology", title: "Piensa en Grande", description: "Abordamos los problemas más difíciles en tecnología empresarial. Si no supera los límites, no nos emociona.", color: "text-nexus-blue", bg: "bg-nexus-blue/10" },
    { icon: "groups", title: "Colaboración Profunda", description: "Operamos como un colectivo muy unido donde cada voz importa.", color: "text-nexus-purple", bg: "bg-nexus-purple/10" },
    { icon: "trending_up", title: "Crecimiento Continuo", description: "Invertimos en nuestra gente. Desde certificaciones hasta conferencias y experimentación práctica.", color: "text-nexus-green", bg: "bg-nexus-green/10" },
    { icon: "workspace_premium", title: "Dueños del Resultado", description: "No solo escribimos código — asumimos la responsabilidad por el impacto de nuestro trabajo.", color: "text-nexus-yellow", bg: "bg-nexus-yellow/10" },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-hidden">
        <Navbar />

        <main class="pt-40 pb-24">
            <div class="max-w-5xl mx-auto px-6 lg:px-12 text-center mb-24">
                <span class="text-sm font-bold tracking-[0.3em] uppercase text-nexus-green mb-6 block">Carreras</span>
                <h1 class="text-5xl md:text-7xl font-display font-bold text-slate-900 dark:text-white mb-8 tracking-tighter leading-[1] transition-colors">
                    Construye el Futuro <span class="text-gradient">Con Nosotros</span>
                </h1>
                <p class="max-w-2xl mx-auto text-xl text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">
                    Somos un colectivo de arquitectos, expertos en seguridad y especialistas en IA que creen que la tecnología debe crear resultados extraordinarios.
                </p>
            </div>

            <div class="max-w-5xl mx-auto px-6 lg:px-12 mb-24">
                <h2 class="text-sm font-bold tracking-[0.3em] uppercase text-nexus-blue mb-12 text-center">Lo Que Nos Impulsa</h2>
                <div class="grid sm:grid-cols-2 gap-8">
                    {values.map((value) => (
                        <div class="group p-8 rounded-2xl bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-800 hover:border-nexus-blue/30 transition-all hover:shadow-lg">
                            <div class={`w-14 h-14 rounded-xl ${value.bg} flex items-center justify-center mb-6 group-hover:scale-110 transition-transform`}>
                                <span class={`material-symbols-outlined ${value.color}`} style="font-size: 26px;">{value.icon}</span>
                            </div>
                            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">{value.title}</h3>
                            <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed text-sm transition-colors">{value.description}</p>
                        </div>
                    ))}
                </div>
            </div>

            <div class="max-w-5xl mx-auto px-6 lg:px-12">
                <div class="relative bg-[#050505] rounded-3xl overflow-hidden border border-gray-800 p-12 md:p-20 text-center">
                    <div class="absolute -top-24 -right-24 w-96 h-96 bg-nexus-purple/20 rounded-full blur-[100px] animate-pulse-slow"></div>
                    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-nexus-blue/20 rounded-full blur-[100px] animate-pulse-slow" style="animation-delay: 1s;"></div>
                    <div class="relative z-10">
                        <div class="inline-flex items-center space-x-2 mb-6">
                            <span class="relative flex h-3 w-3">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-nexus-green opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-3 w-3 bg-nexus-green"></span>
                            </span>
                            <span class="text-nexus-green font-bold tracking-wider text-xs uppercase">Estamos Contratando</span>
                        </div>
                        <h2 class="text-3xl md:text-5xl font-display font-bold text-white mb-6 leading-tight">
                            ¿No Ves tu Rol?<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-nexus-purple via-nexus-blue to-nexus-green">Contáctanos de Todos Modos</span>
                        </h2>
                        <p class="text-lg text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed">
                            Siempre estamos buscando talento excepcional en arquitectura cloud, ingeniería AI/ML, ciberseguridad y consultoría estratégica.
                        </p>
                        <a href="mailto:hello@nexusinnova.com?subject=Career%20Inquiry%20-%20Nexus%20Digital%20Innovations" class="inline-flex items-center gap-3 px-10 py-5 bg-white text-slate-900 rounded-xl font-extrabold text-lg hover:bg-gray-50 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)] hover:shadow-[0_0_40px_rgba(255,255,255,0.5)] hover:-translate-y-1">
                            Envía tu Perfil
                            <span class="material-symbols-outlined">mail</span>
                        </a>
                        <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-slate-500">
                            <div class="flex items-center"><span class="material-symbols-outlined text-nexus-blue mr-2 text-lg">public</span><span>Amigable con Remoto</span></div>
                            <div class="flex items-center"><span class="material-symbols-outlined text-nexus-purple mr-2 text-lg">school</span><span>Presupuesto de Aprendizaje</span></div>
                            <div class="flex items-center"><span class="material-symbols-outlined text-nexus-green mr-2 text-lg">diversity_3</span><span>Cultura Inclusiva</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <Footer />
    </div>
</Layout>
