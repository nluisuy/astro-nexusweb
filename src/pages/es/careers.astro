---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";

const pageTitle = "Carreras en Nexus";
const pageDescription = "Únete a Nexus Digital Innovations — buscamos arquitectos, estrategas e innovadores que prosperen construyendo soluciones digitales de grado empresarial.";

const values = [
    { icon: "neurology", title: "Piensa en grande", desc: "Abordamos los problemas más difíciles en tecnología empresarial. Si no supera los límites, no nos emociona." },
    { icon: "groups", title: "Colaboración profunda", desc: "Operamos como un colectivo muy unido donde cada voz importa." },
    { icon: "trending_up", title: "Crecimiento continuo", desc: "Invertimos en nuestra gente. Desde certificaciones hasta conferencias y experimentación práctica." },
    { icon: "workspace_premium", title: "Dueños del resultado", desc: "No solo escribimos código — asumimos la responsabilidad por el impacto de nuestro trabajo." },
];
const perks = [
    { icon: "public", label: "Trabajo remoto" },
    { icon: "school", label: "Presupuesto de aprendizaje" },
    { icon: "diversity_3", label: "Cultura inclusiva" },
    { icon: "location_on", label: "Montevideo · Buenos Aires · Philadelphia" },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-clip">
        <Navbar />

        <main>
            <PageHero
                kicker="Carreras"
                title="Construye el futuro"
                accent="con nosotros."
                lead="Somos un colectivo de arquitectos, expertos en seguridad y especialistas en IA que creen que la tecnología debe crear resultados extraordinarios."
            />

            <section class="relative pb-24 lg:pb-32">
                <div class="max-w-7xl mx-auto px-6 lg:px-12">
                    <div class="nx-kicker mb-5">Lo que nos impulsa</div>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
                        {
                            values.map((v) => (
                                <div class="nx-glass nx-glass--hover reveal p-6">
                                    <span class="nx-icon-tile mb-4">
                                        <span class="material-symbols-outlined text-[1.25rem]">{v.icon}</span>
                                    </span>
                                    <h3 class="font-display font-bold text-slate-900 dark:text-white text-[1.05rem] tracking-tight mb-2">{v.title}</h3>
                                    <p class="text-[0.86rem] leading-relaxed text-slate-500 dark:text-slate-400 font-light">{v.desc}</p>
                                </div>
                            ))
                        }
                    </div>

                    <div class="hire-band reveal">
                        <div class="min-w-0">
                            <span class="nx-mono inline-flex items-center gap-2 text-[0.66rem] tracking-[0.2em] uppercase text-nexus-green mb-4">
                                <span class="hire-dot"></span>Estamos contratando
                            </span>
                            <h2 class="font-display font-extrabold tracking-[-0.03em] leading-[1.02] text-3xl md:text-[2.6rem] text-slate-900 dark:text-white mb-4">
                                ¿No ves tu rol? <span class="accent-grad">Escríbenos igual.</span>
                            </h2>
                            <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg font-light leading-relaxed max-w-2xl mb-7">
                                Siempre buscamos talento excepcional en arquitectura cloud, ingeniería AI/ML, ciberseguridad y consultoría estratégica.
                            </p>
                            <div class="flex flex-wrap items-center gap-4">
                                <a href="mailto:hello@nexusinnova.com?subject=Consulta%20de%20carrera%20-%20Nexus%20Digital%20Innovations" class="nx-cta">
                                    Envía tu perfil
                                    <span class="material-symbols-outlined text-lg">arrow_right_alt</span>
                                </a>
                                <span class="nx-mono text-xs text-slate-400 dark:text-slate-500">hello@nexusinnova.com</span>
                            </div>
                        </div>
                        <ul class="hire-perks">
                            {
                                perks.map((p) => (
                                    <li>
                                        <span class="material-symbols-outlined text-[1.05rem] text-nexus-purple">{p.icon}</span>
                                        {p.label}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
    </div>
</Layout>

<style>
    .hire-band {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 24px 40px;
        padding: 32px;
        border-radius: 20px;
        border: 1px solid rgba(245, 158, 66, 0.35);
        background: linear-gradient(100deg, rgba(99, 102, 241, 0.08), rgba(245, 158, 66, 0.1));
        backdrop-filter: blur(10px);
    }
    :global(.dark) .hire-band {
        background: linear-gradient(100deg, rgba(99, 102, 241, 0.14), rgba(245, 158, 66, 0.12));
        border-color: rgba(245, 158, 66, 0.3);
    }
    .hire-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
    }
    .hire-perks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 260px;
    }
    .hire-perks li {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid rgba(100, 116, 139, 0.16);
        background: rgba(255, 255, 255, 0.55);
        font-size: 0.84rem;
        color: #334155;
    }
    :global(.dark) .hire-perks li {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(148, 163, 184, 0.14);
        color: #cbd5e1;
    }
</style>
