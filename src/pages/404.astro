---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Page Not Found";
const pageDescription = "The page you're looking for doesn't exist. Navigate back to Nexus Digital Innovations.";
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-hidden">
        <Navbar />

        <main class="pt-40 pb-24 flex items-center justify-center min-h-[70vh]">
            <div class="max-w-2xl mx-auto px-6 lg:px-12 text-center">
                <h1 class="text-8xl md:text-[12rem] font-display font-bold tracking-tighter leading-none mb-4">
                    <span class="text-gradient">404</span>
                </h1>
                <h2 class="text-2xl md:text-3xl font-display font-bold text-slate-900 dark:text-white mb-6 transition-colors">
                    Lost in the Architecture
                </h2>
                <p class="text-lg text-slate-500 dark:text-slate-400 font-light leading-relaxed mb-12 max-w-lg mx-auto transition-colors">
                    The page you're looking for doesn't exist or has been moved. Let's get you back on track.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a href="/" class="px-10 py-5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-slate-800 dark:hover:bg-gray-100 transition-all shadow-xl shadow-slate-200 dark:shadow-none hover:-translate-y-1 flex items-center gap-3">
                        <span class="material-symbols-outlined">home</span>
                        Back to Home
                    </a>
                    <a href="mailto:hello@nexusinnova.com" class="px-10 py-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white rounded-full font-bold text-sm uppercase tracking-widest hover:border-slate-400 dark:hover:border-slate-500 transition-all flex items-center gap-3">
                        <span class="material-symbols-outlined">mail</span>
                        Contact Us
                    </a>
                </div>
            </div>
        </main>

        <Footer />
    </div>
</Layout>
