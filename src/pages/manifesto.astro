---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Our Manifesto";
const pageDescription = "The Nexus Digital Innovations manifesto — our principles for building the future of enterprise technology through precision, innovation, and integrity.";
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-hidden">
        <Navbar />

        <main class="pt-40 pb-24">
            <div class="max-w-5xl mx-auto px-6 lg:px-12 text-center mb-24">
                <span class="text-sm font-bold tracking-[0.3em] uppercase text-nexus-blue mb-6 block">Our Manifesto</span>
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-slate-900 dark:text-white mb-8 tracking-tighter leading-[1] transition-colors">
                    We Build What <span class="text-gradient">Matters</span>
                </h1>
                <p class="max-w-2xl mx-auto text-xl text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">
                    In a world flooded with noise, we choose substance. Every line of architecture, every security protocol, every AI model we deploy exists to create lasting impact.
                </p>
            </div>

            <div class="max-w-5xl mx-auto px-6 lg:px-12">
                <div class="grid md:grid-cols-2 gap-16 mb-24">
                    <div class="space-y-8">
                        <div class="group">
                            <div class="flex items-start gap-6">
                                <div class="w-16 h-16 rounded-2xl bg-nexus-blue/10 flex items-center justify-center flex-shrink-0 group-hover:bg-nexus-blue/20 transition-colors">
                                    <span class="material-symbols-outlined text-nexus-blue" style="font-size: 28px;">architecture</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">Precision Over Speed</h3>
                                    <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">We don't rush to ship. We architect with intention, building systems that scale gracefully and endure the test of enterprise demands.</p>
                                </div>
                            </div>
                        </div>
                        <div class="group">
                            <div class="flex items-start gap-6">
                                <div class="w-16 h-16 rounded-2xl bg-nexus-purple/10 flex items-center justify-center flex-shrink-0 group-hover:bg-nexus-purple/20 transition-colors">
                                    <span class="material-symbols-outlined text-nexus-purple" style="font-size: 28px;">shield_with_house</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">Security Is a Foundation</h3>
                                    <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">Security isn't an afterthought. It's embedded in every decision, every deployment, every interaction.</p>
                                </div>
                            </div>
                        </div>
                        <div class="group">
                            <div class="flex items-start gap-6">
                                <div class="w-16 h-16 rounded-2xl bg-nexus-green/10 flex items-center justify-center flex-shrink-0 group-hover:bg-nexus-green/20 transition-colors">
                                    <span class="material-symbols-outlined text-nexus-green" style="font-size: 28px;">neurology</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">AI With Purpose</h3>
                                    <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">We leverage generative AI not because it's trendy, but because it unlocks real value with measurable ROI.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="space-y-8">
                        <div class="group">
                            <div class="flex items-start gap-6">
                                <div class="w-16 h-16 rounded-2xl bg-nexus-yellow/10 flex items-center justify-center flex-shrink-0 group-hover:bg-nexus-yellow/20 transition-colors">
                                    <span class="material-symbols-outlined text-nexus-yellow" style="font-size: 28px;">handshake</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">Partnership, Not Vendorship</h3>
                                    <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">We don't sell services — we invest in outcomes. Our clients' success is our success.</p>
                                </div>
                            </div>
                        </div>
                        <div class="group">
                            <div class="flex items-start gap-6">
                                <div class="w-16 h-16 rounded-2xl bg-nexus-red/10 flex items-center justify-center flex-shrink-0 group-hover:bg-nexus-red/20 transition-colors">
                                    <span class="material-symbols-outlined text-nexus-red" style="font-size: 28px;">rocket_launch</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">Relentless Innovation</h3>
                                    <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">The technology landscape never stands still, and neither do we. We continuously evolve our methodologies.</p>
                                </div>
                            </div>
                        </div>
                        <div class="group">
                            <div class="flex items-start gap-6">
                                <div class="w-16 h-16 rounded-2xl bg-nexus-blue/10 flex items-center justify-center flex-shrink-0 group-hover:bg-nexus-blue/20 transition-colors">
                                    <span class="material-symbols-outlined text-nexus-blue" style="font-size: 28px;">visibility</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 font-display transition-colors">Radical Transparency</h3>
                                    <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">No black boxes. No hidden agendas. We communicate openly about timelines, challenges, and trade-offs.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center py-16 border-t border-gray-100 dark:border-slate-800 transition-colors">
                    <blockquote class="text-2xl md:text-3xl font-display font-medium text-slate-900 dark:text-white max-w-3xl mx-auto leading-relaxed italic transition-colors">
                        "We exist at the intersection of vision and refined technical execution — where every solution is crafted to define new standards of digital excellence."
                    </blockquote>
                    <div class="mt-10">
                        <a href="/#contact" class="inline-flex items-center gap-3 px-10 py-5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full font-bold text-sm uppercase tracking-widest hover:bg-slate-800 dark:hover:bg-gray-100 transition-all shadow-xl shadow-slate-200 dark:shadow-none hover:-translate-y-1">
                            Start the Conversation
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <Footer />
    </div>
</Layout>
