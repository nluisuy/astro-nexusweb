---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";

const pageTitle = "Our Manifesto";
const pageDescription = "The Nexus Digital Innovations manifesto — our principles for building the future of enterprise technology through precision, innovation, and integrity.";

const principles = [
    { icon: "architecture", title: "Precision over speed", desc: "We don't rush to ship. We architect with intention, building systems that scale gracefully and endure the test of enterprise demands." },
    { icon: "shield_with_house", title: "Security is a foundation", desc: "Security isn't an afterthought. It's embedded in every decision, every deployment, every interaction." },
    { icon: "neurology", title: "AI with purpose", desc: "We leverage generative AI not because it's trendy, but because it unlocks real value with measurable ROI." },
    { icon: "handshake", title: "Partnership, not vendorship", desc: "We don't sell services — we invest in outcomes. Our clients' success is our success." },
    { icon: "rocket_launch", title: "Relentless innovation", desc: "The technology landscape never stands still, and neither do we. We continuously evolve our methodologies." },
    { icon: "visibility", title: "Radical transparency", desc: "No black boxes. No hidden agendas. We communicate openly about timelines, challenges, and trade-offs." },
];
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="relative min-h-screen overflow-x-clip">
        <Navbar />

        <main>
            <PageHero
                kicker="Our manifesto"
                title="We build what"
                accent="matters."
                lead="In a world flooded with noise, we choose substance. Every line of architecture, every security protocol, every AI model we deploy exists to create lasting impact."
            />

            <section class="relative pb-24 lg:pb-32">
                <div class="max-w-7xl mx-auto px-6 lg:px-12">
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
                        {
                            principles.map((p) => (
                                <div class="nx-glass nx-glass--hover reveal p-6">
                                    <span class="nx-icon-tile mb-4">
                                        <span class="material-symbols-outlined text-[1.25rem]">{p.icon}</span>
                                    </span>
                                    <h3 class="font-display font-bold text-slate-900 dark:text-white text-[1.08rem] tracking-tight mb-2">{p.title}</h3>
                                    <p class="text-[0.88rem] leading-relaxed text-slate-500 dark:text-slate-400 font-light">{p.desc}</p>
                                </div>
                            ))
                        }
                    </div>

                    <div class="relative nx-glass reveal p-8 md:p-12 overflow-hidden">
                        <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
                        <div class="nx-kicker mb-5">Why we exist</div>
                        <blockquote class="font-display font-extrabold tracking-[-0.03em] leading-[1.1] text-2xl md:text-[2.1rem] text-slate-900 dark:text-white max-w-3xl mb-8">
                            We exist at the intersection of vision and refined technical execution — where every solution is crafted to define new standards of digital excellence.
                        </blockquote>
                        <a href="/#contact" class="nx-cta">
                            Start the conversation
                            <span class="material-symbols-outlined text-lg">arrow_right_alt</span>
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
    </div>
</Layout>
