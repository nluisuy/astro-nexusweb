---
// Book your strategy session — one clear offer (what you get, how it works)
// plus where we are. Opens the contact modal (index.astro listens for the event).
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

const steps = [1, 2, 3].map((n) => ({
    n: `0${n}`,
    title: t(`booking.step${n}.t` as any) as string,
    desc: t(`booking.step${n}.d` as any) as string,
}));
const cities = [
    { city: t("booking.city1") as string, country: t("booking.country1") as string, tz: "GMT-3" },
    { city: t("booking.city2") as string, country: t("booking.country2") as string, tz: "GMT-3" },
    { city: t("booking.city3") as string, country: t("booking.country3") as string, tz: "GMT-5" },
];
---

<section id="contact" class="relative py-28 lg:py-36 overflow-hidden">
    <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
    <div
        class="absolute -top-40 right-[-8%] w-[42%] h-[42%] rounded-full blur-[140px] bg-nexus-amber/8 dark:bg-nexus-amber/10 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div
        class="relative max-w-7xl mx-auto px-6 lg:px-12 grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-14 items-start"
    >
        <!-- Offer -->
        <div class="reveal">
            <div class="nx-kicker mb-5">{t("booking.kicker")}</div>
            <h2
                class="font-display font-extrabold tracking-[-0.035em] leading-[0.98] text-4xl md:text-5xl lg:text-[3.6rem] text-slate-900 dark:text-white mb-5"
            >
                {t("booking.title")}
            </h2>
            <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg font-light leading-relaxed max-w-2xl mb-8">
                {t("booking.desc")}
            </p>

            <div class="nx-kicker mb-3">{t("booking.get")}</div>
            <ul class="bk-list">
                <li><i class="nx-check"></i><span>{t("booking.get1")}</span></li>
                <li><i class="nx-check"></i><span>{t("booking.get2")}</span></li>
                <li><i class="nx-check"></i><span>{t("booking.get3")}</span></li>
            </ul>

            <div class="flex flex-wrap items-center gap-4 mt-8">
                <button id="openContactBtn" type="button" class="nx-cta">
                    {t("booking.btn")}
                    <span class="material-symbols-outlined text-lg">arrow_right_alt</span>
                </button>
                <span class="nx-mono text-xs text-slate-400 dark:text-slate-500">{t("booking.alt")}</span>
            </div>
        </div>

        <!-- How it works + presence -->
        <div class="flex flex-col gap-4 reveal reveal-delay-2">
            <div class="bk-card">
                <div class="nx-kicker mb-4">{t("booking.how")}</div>
                <ol class="bk-steps">
                    {
                        steps.map((s) => (
                            <li>
                                <span class="nx-mono bk-step-n">{s.n}</span>
                                <div class="min-w-0">
                                    <div class="font-display font-bold text-slate-900 dark:text-white text-[0.98rem] tracking-tight">
                                        {s.title}
                                    </div>
                                    <div class="text-[0.8rem] text-slate-500 dark:text-slate-400">{s.desc}</div>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </div>

            <div class="bk-card">
                <div class="flex items-center justify-between gap-3 mb-1">
                    <div class="nx-kicker">{t("booking.presence")}</div>
                    <span class="nx-mono inline-flex items-center gap-2 text-[0.64rem] text-nexus-green">
                        <span class="bk-dot"></span>LATAM · USA
                    </span>
                </div>
                <p class="text-[0.84rem] text-slate-500 dark:text-slate-400 mb-4">{t("booking.presence.desc")}</p>
                <ul class="bk-cities">
                    {
                        cities.map((c) => (
                            <li class="booking-glass-card">
                                <span class="material-symbols-outlined text-[1.1rem] text-nexus-purple">location_on</span>
                                <span class="font-display font-bold text-slate-900 dark:text-white text-[0.95rem]">{c.city}</span>
                                <span class="text-[0.8rem] text-slate-500 dark:text-slate-400">{c.country}</span>
                                <span class="nx-mono bk-tz">{c.tz}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<style>
    .bk-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 11px;
        max-width: 34rem;
    }
    .bk-list li {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        font-size: 0.95rem;
        line-height: 1.45;
        color: #475569;
    }
    :global(.dark) .bk-list li {
        color: #cbd5e1;
    }
    .bk-card {
        padding: 22px;
        border-radius: 18px;
        border: 1px solid rgba(100, 116, 139, 0.18);
        background: rgba(255, 255, 255, 0.66);
        backdrop-filter: blur(10px);
    }
    :global(.dark) .bk-card {
        background: rgba(15, 23, 42, 0.55);
        border-color: rgba(148, 163, 184, 0.16);
    }
    .bk-steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .bk-steps li {
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }
    .bk-step-n {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
    }
    .bk-cities {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .bk-cities li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid rgba(100, 116, 139, 0.14);
        background: rgba(255, 255, 255, 0.5);
    }
    :global(.dark) .bk-cities li {
        background: rgba(15, 23, 42, 0.45);
        border-color: rgba(148, 163, 184, 0.12);
    }
    .bk-tz {
        margin-left: auto;
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        color: #94a3b8;
    }
    .bk-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
    }
</style>

<script>
    document.getElementById("openContactBtn")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("openContactModal"));
    });
</script>
