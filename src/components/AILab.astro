---

---

<section class="py-24 bg-white dark:bg-slate-950 transition-colors duration-300" id="ai-lab">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="mb-16 reveal">
            <h2 class="text-sm font-bold tracking-[0.3em] uppercase text-nexus-purple mb-4">
                AI Innovation Lab
            </h2>
            <p class="text-3xl md:text-4xl lg:text-5xl font-display font-medium text-slate-900 dark:text-white max-w-2xl transition-colors">
                The engine behind our AI-first approach.
            </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-start">
            <!-- Left: Tech Stack Grid -->
            <div class="reveal">
                <p class="text-lg text-slate-500 dark:text-slate-400 font-light leading-relaxed mb-10 transition-colors">
                    We don't just advise on AI — we build and deploy production-grade agent systems. Our lab is where enterprise AI goes from concept to measurable impact.
                </p>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    {[
                        { name: "LangChain", icon: "link", color: "text-emerald-500" },
                        { name: "RAG Pipelines", icon: "database", color: "text-nexus-blue" },
                        { name: "Vector DBs", icon: "scatter_plot", color: "text-nexus-purple" },
                        { name: "Fine-Tuning", icon: "tune", color: "text-orange-500" },
                        { name: "Agent Orchestration", icon: "account_tree", color: "text-nexus-red" },
                        { name: "Model Evaluation", icon: "speed", color: "text-nexus-green" },
                        { name: "Prompt Engineering", icon: "edit_note", color: "text-cyan-500" },
                        { name: "Multi-Agent Systems", icon: "hub", color: "text-indigo-500" },
                        { name: "Guardrails & Safety", icon: "shield", color: "text-nexus-yellow" },
                    ].map((tech) => (
                        <div class="group flex items-center gap-3 p-4 rounded-xl bg-nexus-gray-soft dark:bg-slate-900 border border-gray-100 dark:border-slate-800 hover:border-nexus-blue/30 dark:hover:border-nexus-blue/30 transition-all duration-300 hover:shadow-md cursor-default">
                            <span class={`material-symbols-outlined text-xl ${tech.color}`}>
                                {tech.icon}
                            </span>
                            <span class="text-sm font-medium text-slate-700 dark:text-slate-300 transition-colors">
                                {tech.name}
                            </span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Right: AI Agent Architecture Diagram -->
            <div class="reveal reveal-delay-2">
                <div class="relative p-8 md:p-10 rounded-3xl bg-[#0a0a0f] border border-slate-800 overflow-hidden">
                    <!-- Background glow -->
                    <div class="absolute -top-20 -right-20 w-60 h-60 bg-nexus-purple/15 rounded-full blur-[80px]"></div>
                    <div class="absolute -bottom-20 -left-20 w-60 h-60 bg-nexus-blue/15 rounded-full blur-[80px]"></div>

                    <div class="relative z-10">
                        <h3 class="text-lg font-bold text-white mb-8 flex items-center gap-2">
                            <span class="material-symbols-outlined text-nexus-purple">architecture</span>
                            Agent Architecture
                        </h3>

                        <!-- Architecture Flow -->
                        <div class="space-y-4">
                            <!-- User Input -->
                            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
                                <div class="w-8 h-8 rounded-lg bg-nexus-blue/20 flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined text-nexus-blue text-sm">person</span>
                                </div>
                                <span class="text-sm text-white font-medium">User Request / Business Trigger</span>
                            </div>

                            <!-- Arrow -->
                            <div class="flex justify-center">
                                <span class="material-symbols-outlined text-slate-600 text-lg">arrow_downward</span>
                            </div>

                            <!-- Orchestrator -->
                            <div class="p-4 rounded-xl bg-nexus-purple/10 border border-nexus-purple/30">
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="material-symbols-outlined text-nexus-purple text-sm">hub</span>
                                    <span class="text-sm font-bold text-nexus-purple">Orchestration Layer</span>
                                </div>
                                <p class="text-xs text-slate-400 leading-relaxed">Routes tasks to specialized agents, manages state, and ensures quality.</p>
                            </div>

                            <!-- Arrow -->
                            <div class="flex justify-center">
                                <span class="material-symbols-outlined text-slate-600 text-lg">arrow_downward</span>
                            </div>

                            <!-- Agent Grid -->
                            <div class="grid grid-cols-3 gap-2">
                                {[
                                    { name: "Research Agent", icon: "search", color: "bg-nexus-blue/20 text-nexus-blue" },
                                    { name: "Code Agent", icon: "code", color: "bg-emerald-500/20 text-emerald-400" },
                                    { name: "Review Agent", icon: "rate_review", color: "bg-orange-500/20 text-orange-400" },
                                ].map((agent) => (
                                    <div class={`p-3 rounded-xl bg-white/5 border border-white/10 text-center`}>
                                        <div class={`w-8 h-8 rounded-lg ${agent.color} flex items-center justify-center mx-auto mb-2`}>
                                            <span class="material-symbols-outlined text-sm">{agent.icon}</span>
                                        </div>
                                        <span class="text-[0.65rem] text-slate-400 font-medium leading-tight block">{agent.name}</span>
                                    </div>
                                ))}
                            </div>

                            <!-- Arrow -->
                            <div class="flex justify-center">
                                <span class="material-symbols-outlined text-slate-600 text-lg">arrow_downward</span>
                            </div>

                            <!-- Knowledge Layer -->
                            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
                                <div class="w-8 h-8 rounded-lg bg-nexus-green/20 flex items-center justify-center flex-shrink-0">
                                    <span class="material-symbols-outlined text-nexus-green text-sm">database</span>
                                </div>
                                <div>
                                    <span class="text-sm text-white font-medium block">Knowledge Base</span>
                                    <span class="text-[0.65rem] text-slate-500">RAG · Vector Store · Enterprise Data</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
