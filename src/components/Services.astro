---
import type { ServiceItem } from "../types";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

const services: ServiceItem[] = [
    {
        id: "ai",
        title: t('services.item.ai.title') as string,
        description: t('services.item.ai.desc') as string,
        icon: "neurology",
        color: "text-nexus-red",
    },
    {
        id: "devpods",
        title: t('services.item.devpods.title') as string,
        description: t('services.item.devpods.desc') as string,
        icon: "group_work",
        color: "text-orange-500",
    },
    {
        id: "infra",
        title: t('services.item.infra.title') as string,
        description: t('services.item.infra.desc') as string,
        icon: "dns",
        color: "text-nexus-blue",
    },
    {
        id: "cyber",
        title: t('services.item.cyber.title') as string,
        description: t('services.item.cyber.desc') as string,
        icon: "admin_panel_settings",
        color: "text-nexus-purple",
    },
    {
        id: "cto",
        title: t('services.item.cto.title') as string,
        description: t('services.item.cto.desc') as string,
        icon: "manage_accounts",
        color: "text-nexus-blue",
    },
    {
        id: "ciso",
        title: t('services.item.ciso.title') as string,
        description: t('services.item.ciso.desc') as string,
        icon: "verified_user",
        color: "text-nexus-green",
    },
];
---

<section class="py-32 bg-nexus-gray-soft dark:bg-slate-950 transition-colors duration-300" id="services">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="mb-24 reveal">
            <h2 class="text-sm font-bold tracking-[0.3em] uppercase text-nexus-blue mb-4">
                {t('services.badge')}
            </h2>
            <p
                class="text-3xl md:text-4xl lg:text-5xl font-display font-medium text-slate-900 dark:text-white max-w-xl transition-colors"
            >
                {t('services.title')}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                services.map((service) => (
                    <div
                        class={`service-tile group reveal p-8 rounded-2xl bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-800 cursor-default transition-all duration-300 hover:shadow-2xl hover:shadow-slate-200/50 dark:hover:shadow-none hover:border-nexus-blue/20 dark:hover:border-nexus-blue/30 ${service.id === 'ai' || service.id === 'devpods' ? 'ring-1 ring-nexus-blue/10 dark:ring-nexus-blue/20 hover:bg-gradient-to-br hover:from-nexus-purple/5 hover:to-nexus-blue/10 dark:hover:from-nexus-purple/10 dark:hover:to-nexus-blue/20' : 'hover:bg-slate-50 dark:hover:bg-slate-800/50'}`}
                        style={`transition-delay: ${0.1 * (services.indexOf(service) + 1)}s; transform-style: preserve-3d; will-change: transform;`}
                    >
                        <div class="pointer-events-none" style="transform: translateZ(20px);">
                            <div class="w-14 h-14 rounded-2xl bg-nexus-gray-soft dark:bg-slate-800 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300">
                                <span class={`material-symbols-outlined text-3xl ${service.color}`}>
                                    {service.icon}
                                </span>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight transition-colors">
                                {service.title}
                                {(service.id === 'ai' || service.id === 'devpods') && (
                                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[0.6rem] font-bold tracking-wider uppercase bg-nexus-blue/10 text-nexus-blue dark:bg-nexus-blue/20">
                                        AI-Powered
                                    </span>
                                )}
                            </h3>
                            <p class="text-slate-500 dark:text-slate-400 font-light leading-relaxed transition-colors">
                                {service.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    // 3D Tilt effect for service tiles
    document.querySelectorAll('.service-tile').forEach((tile) => {
        const el = tile as HTMLElement;

        el.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = ((y - centerY) / centerY) * -8;
            const rotateY = ((x - centerX) / centerX) * 8;

            el.style.transform = `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        });

        el.addEventListener('mouseleave', () => {
            el.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        });
    });
</script>
