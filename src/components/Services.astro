---
// Services — "Areas of Excellence" continued in the deck's language:
// the three verticals (with their mesh motif) + the other services on the mesh.
import Motif from "./Motif.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
const aas = t("hero.aas") as string;

const verticals = [
    { key: "infra", n: "01", kind: "grid", color: "text-nexus-blue" },
    { key: "security", n: "02", kind: "ring", color: "text-nexus-purple" },
    { key: "pod", n: "03", kind: "cluster", color: "text-nexus-amber" },
] as const;

const also = [
    { key: "ai", icon: "neurology" },
    { key: "devpods", icon: "group_work" },
    { key: "cto", icon: "manage_accounts" },
    { key: "ciso", icon: "verified_user" },
] as const;
---

<section id="services" class="relative py-28 lg:py-36 overflow-hidden">
    <!-- the mesh's signal thread continues out of the deck -->
    <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
    <div
        class="absolute -top-40 right-[-10%] w-[46%] h-[46%] rounded-full blur-[140px] bg-nexus-purple/6 dark:bg-nexus-purple/10 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
        <div class="reveal mb-16 lg:mb-20 max-w-3xl">
            <div class="nx-kicker mb-5">{t("services.kicker")}</div>
            <h2
                class="font-display font-extrabold tracking-[-0.035em] leading-[0.98] text-4xl md:text-5xl lg:text-[3.6rem] text-slate-900 dark:text-white mb-5"
            >
                {t("services.title")}
            </h2>
            <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg font-light leading-relaxed max-w-2xl">
                {t("services.lead")}
            </p>
        </div>

        <!-- The three verticals -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            {
                verticals.map((v) => (
                    <div class="vcard-wrap">
                    <article class="service-tile vcard group">
                        <div class={`vcard-motif ${v.color}`}>
                            <Motif kind={v.kind} />
                        </div>
                        <div class="nx-kicker mb-3">
                            {v.n} · {t(`hero.p.${v.key}.title` as any)}
                        </div>
                        <h3 class="font-display font-extrabold tracking-[-0.03em] leading-[1.02] text-[1.75rem] lg:text-[1.95rem] mb-5">
                            <span class="accent-grad">{t(`hero.word.${v.key}` as any)}</span>
                            <br />
                            <span class="text-slate-900 dark:text-white">{aas}</span>
                        </h3>
                        <ul class="vcard-list">
                            <li>
                                <i class="nx-check" />
                                <span>{t(`hero.p.${v.key}.b1` as any)}</span>
                            </li>
                            <li>
                                <i class="nx-check" />
                                <span>{t(`hero.p.${v.key}.b2` as any)}</span>
                            </li>
                            <li>
                                <i class="nx-check" />
                                <span>{t(`hero.p.${v.key}.b3` as any)}</span>
                            </li>
                        </ul>
                        <div class="vcard-foot">
                            <span class="nx-mono vcard-metric">
                                {t(`hero.p.${v.key}.metric` as any)}
                                <small>{t(`hero.p.${v.key}.metriclabel` as any)}</small>
                            </span>
                            <button type="button" class="nx-free js-open-planner" data-mode="poc" data-poc={v.key}>
                                <span class="material-symbols-outlined text-[1rem]">bolt</span>
                                {t(`hero.p.${v.key}.free` as any)}
                            </button>
                        </div>
                    </article>
                    </div>
                ))
            }
        </div>

        <!-- Also on the mesh -->
        <div class="reveal mt-14 lg:mt-16">
            <div class="nx-kicker mb-5">{t("services.also")}</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                {
                    also.map((s) => (
                        <div class="acard group">
                            <span class="acard-icon">
                                <span class="material-symbols-outlined text-[1.25rem]">{s.icon}</span>
                            </span>
                            <div class="min-w-0">
                                <h4 class="font-display font-bold text-slate-900 dark:text-white text-[0.98rem] tracking-tight mb-1">
                                    {t(`services.item.${s.key}.title` as any)}
                                </h4>
                                <p class="text-[0.84rem] leading-relaxed text-slate-500 dark:text-slate-400 font-light">
                                    {t(`services.item.${s.key}.desc` as any)}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .vcard-wrap {
        display: flex; /* the article fills the wrapper so the three cards stay level */
        will-change: transform, opacity;
    }
    .vcard {
        position: relative;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column; /* footer pinned to the bottom so the three cards line up */
        padding: 26px 26px 24px;
        border-radius: 20px;
        border: 1px solid rgba(100, 116, 139, 0.18);
        background: rgba(255, 255, 255, 0.66);
        backdrop-filter: blur(10px);
        transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
        will-change: transform;
    }
    :global(.dark) .vcard {
        background: rgba(15, 23, 42, 0.55);
        border-color: rgba(148, 163, 184, 0.16);
    }
    .vcard:hover {
        border-color: rgba(99, 102, 241, 0.55);
        box-shadow: 0 30px 60px -30px rgba(99, 102, 241, 0.45);
    }
    .vcard-motif {
        height: 118px;
        margin: -4px -4px 14px;
        padding: 6px 10px;
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(99, 102, 241, 0.07), transparent);
        display: flex;
        align-items: center;
        transition: transform 0.4s ease;
    }
    .vcard:hover .vcard-motif {
        transform: translateY(-2px) scale(1.03);
    }
    /* the motif SVG has no intrinsic size: size it by the band's height, never the card's width */
    .vcard-motif :global(svg) {
        height: 100%;
        width: auto;
        max-width: 100%;
    }
    .vcard-list {
        list-style: none;
        margin: 0 0 18px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .vcard-list li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 0.9rem;
        line-height: 1.42;
        color: #475569;
    }
    :global(.dark) .vcard-list li {
        color: #cbd5e1;
    }
    .vcard-foot {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px 14px;
        padding-top: 16px;
        border-top: 1px solid rgba(100, 116, 139, 0.16);
    }
    .vcard-metric {
        display: flex;
        align-items: baseline;
        gap: 7px;
        font-size: 1.25rem;
        font-weight: 600;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }
    :global(.dark) .vcard-metric {
        color: #f1f5f9;
    }
    .vcard-metric small {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 0.74rem;
        font-weight: 400;
        color: #64748b;
    }
    :global(.dark) .vcard-metric small {
        color: #94a3b8;
    }

    .acard {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid rgba(100, 116, 139, 0.14);
        background: rgba(255, 255, 255, 0.5);
        transition: border-color 0.3s ease, transform 0.3s ease;
    }
    :global(.dark) .acard {
        background: rgba(15, 23, 42, 0.45);
        border-color: rgba(148, 163, 184, 0.12);
    }
    .acard:hover {
        border-color: rgba(99, 102, 241, 0.45);
        transform: translateY(-2px);
    }
    .acard-icon {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #6366f1;
        background: rgba(99, 102, 241, 0.1);
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { wireBooking } from "../lib/book";

    gsap.registerPlugin(ScrollTrigger);

    // Free-POC hooks book a call.
    wireBooking("#services .js-open-planner");

    // ── Scroll-driven entrance (continues the deck's right→left motion) ──
    // Scrubbed to the scroll position, so the cards slide in and settle as you go,
    // and slide back out if you scroll up. Skipped for reduced motion.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const section = document.getElementById("services");
        const wraps = gsap.utils.toArray<HTMLElement>("#services .vcard-wrap");
        const acards = gsap.utils.toArray<HTMLElement>("#services .acard");
        const signal = section?.querySelector<HTMLElement>(".nx-signal");

        if (signal) {
            gsap.fromTo(
                signal,
                { scaleX: 0, transformOrigin: "left center" },
                { scaleX: 1, ease: "none", scrollTrigger: { trigger: section, start: "top 90%", end: "top 40%", scrub: 0.4 } }
            );
        }
        if (wraps.length) {
            gsap.fromTo(
                wraps,
                { x: "38vw", opacity: 0, rotateY: -16, transformPerspective: 900, transformOrigin: "left center" },
                {
                    x: 0,
                    opacity: 1,
                    rotateY: 0,
                    ease: "power2.out",
                    stagger: 0.22,
                    scrollTrigger: { trigger: wraps[0].parentElement, start: "top 88%", end: "top 22%", scrub: 0.6 },
                }
            );
        }
        if (acards.length) {
            gsap.fromTo(
                acards,
                { y: 48, opacity: 0 },
                {
                    y: 0,
                    opacity: 1,
                    ease: "power2.out",
                    stagger: 0.12,
                    scrollTrigger: { trigger: acards[0].parentElement, start: "top 92%", end: "top 55%", scrub: 0.5 },
                }
            );
        }
        document.addEventListener("astro:before-swap", () => ScrollTrigger.getAll().forEach((t) => t.kill()));
    }

    // Light 3D tilt on the vertical cards (desktop pointers only).
    if (window.matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) {
        document.querySelectorAll<HTMLElement>("#services .service-tile").forEach((el) => {
            el.addEventListener("mousemove", (e) => {
                const r = el.getBoundingClientRect();
                const rx = ((e.clientY - r.top) / r.height - 0.5) * -6;
                const ry = ((e.clientX - r.left) / r.width - 0.5) * 6;
                el.style.transform = `perspective(700px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-3px)`;
            });
            el.addEventListener("mouseleave", () => {
                el.style.transform = "";
            });
        });
    }
</script>
