---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
---
<section class="py-20 bg-black border-y border-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-gray-800/50 reveal">
            <div class="px-4">
                <div class="text-4xl font-display font-bold text-white mb-1">{t('stats.item1.title')}</div>
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wider">{t('stats.item1.desc')}</div>
            </div>
            <div class="px-4">
                <div class="text-4xl font-display font-bold text-white mb-1">{t('stats.item2.title')}</div>
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wider">{t('stats.item2.desc')}</div>
            </div>
            <div class="px-4">
                <div class="text-4xl font-display font-bold text-white mb-1">{t('stats.item3.title')}</div>
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wider">{t('stats.item3.desc')}</div>
            </div>
            <div class="px-4">
                <div class="text-4xl font-display font-bold text-white mb-1">{t('stats.item4.title')}</div>
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wider">{t('stats.item4.desc')}</div>
            </div>
        </div>
    </div>
</section>