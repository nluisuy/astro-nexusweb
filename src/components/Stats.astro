---
// Stats — a few real numbers, in the deck's language. ScrollEngine animates the counters
// through the data-count-* attributes.
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

const stats = [1, 2, 3, 4].map((n) => ({
    raw: t(`stats.n${n}.value` as any) as string,
    label: t(`stats.n${n}.label` as any) as string,
}));

// "20+" → { prefix: "", value: "20", suffix: "+" }
function parseStatValue(raw: string) {
    const match = raw.match(/^([^0-9]*)([0-9.]+)(.*)$/);
    if (match) return { prefix: match[1], value: match[2], suffix: match[3] };
    return { prefix: "", value: "0", suffix: raw };
}
---

<section id="stats" class="relative py-16 lg:py-20 overflow-hidden">
    <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {
                stats.map((stat) => {
                    const p = parseStatValue(stat.raw);
                    return (
                        <div class="st-card reveal">
                            <div
                                class="st-value nx-mono accent-grad"
                                data-count-to={p.value}
                                data-count-suffix={p.suffix}
                                data-count-prefix={p.prefix}
                            >
                                {p.prefix}0{p.suffix}
                            </div>
                            <div class="st-label">{stat.label}</div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    .st-card {
        padding: 22px 22px 20px;
        border-radius: 18px;
        border: 1px solid rgba(100, 116, 139, 0.16);
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(10px);
        min-width: 0;
    }
    :global(.dark) .st-card {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(148, 163, 184, 0.14);
    }
    .st-value {
        font-size: clamp(2.2rem, 4vw, 3rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 10px;
    }
    .st-label {
        font-size: 0.82rem;
        line-height: 1.4;
        color: #64748b;
    }
    :global(.dark) .st-label {
        color: #94a3b8;
    }
</style>
