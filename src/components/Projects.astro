---
// Case studies — real engagements, in the deck's language: icon + mesh motif, vertical chip,
// one-line outcome, a highlight, where it happened and the stack. No photography.
// Used on the home page and on the Insights page.
import Motif from "./Motif.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

type Vertical = "infra" | "security" | "pod";
const motifFor: Record<Vertical, "grid" | "ring" | "cluster"> = {
    infra: "grid",
    security: "ring",
    pod: "cluster",
};
const colorFor: Record<Vertical, string> = {
    infra: "text-nexus-blue",
    security: "text-nexus-purple",
    pod: "text-nexus-amber",
};

const cases: { key: string; vertical: Vertical; icon: string; stack: string[]; tag?: string }[] = [
    { key: "c1", vertical: "infra", icon: "cloud_done", stack: ["AWS MAP", "Landing Zone", "Terraform"] },
    { key: "c2", vertical: "infra", icon: "cloud_sync", stack: ["Azure", "AWS", "Kubernetes"] },
    { key: "c3", vertical: "pod", icon: "manage_accounts", stack: ["Roadmap", "Architecture", "Teams"], tag: "cases.c3.tag" },
    { key: "c4", vertical: "security", icon: "health_and_safety", stack: ["Resilience", "Impact tolerances", "Testing"] },
    { key: "c5", vertical: "security", icon: "sync_alt", stack: ["DRP", "BCP", "Multi-region"] },
    { key: "c6", vertical: "pod", icon: "smart_toy", stack: ["AI migration", "Refactoring", "Test generation"] },
    { key: "c7", vertical: "pod", icon: "rocket_launch", stack: ["Innovation Pod", "15-day POC"] },
    { key: "c8", vertical: "pod", icon: "neurology", stack: ["LangChain", "Vector DB"] },
    { key: "c9", vertical: "security", icon: "verified", stack: ["ISO 27001", "PCI DSS"] },
];
---

<section id="projects" class="relative py-28 lg:py-36 overflow-hidden">
    <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
    <div
        class="absolute -bottom-40 left-[-10%] w-[44%] h-[44%] rounded-full blur-[140px] bg-nexus-blue/6 dark:bg-nexus-blue/10 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
        <div class="reveal mb-12 lg:mb-14 max-w-2xl">
            <div class="nx-kicker mb-5">{t("cases.badge")}</div>
            <h2
                class="font-display font-extrabold tracking-[-0.035em] leading-[0.98] text-4xl md:text-5xl text-slate-900 dark:text-white mb-4"
            >
                {t("cases.title")}
            </h2>
            <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg font-light leading-relaxed">
                {t("cases.lead")}
            </p>
        </div>

        <div id="bento-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {
                cases.map((c) => (
                    <article class="bento-card pcard group">
                        <div class="pcard-top">
                            <span class={`pcard-icon ${colorFor[c.vertical]}`}>
                                <span class="material-symbols-outlined text-[1.35rem]">{c.icon}</span>
                            </span>
                            <span class={`pcard-motif ${colorFor[c.vertical]}`}>
                                <Motif kind={motifFor[c.vertical]} />
                            </span>
                        </div>
                        <span class="nx-kicker pcard-chip">
                            {c.tag ? t(c.tag as any) : t(`hero.intent.${c.vertical}` as any)}
                        </span>
                        <h3 class="font-display font-bold text-slate-900 dark:text-white text-[1.12rem] tracking-tight leading-snug mt-2 mb-1">
                            {t(`cases.${c.key}.title` as any)}
                        </h3>
                        <div class="nx-mono pcard-where">{t(`cases.${c.key}.where` as any)}</div>
                        <p class="text-[0.86rem] leading-relaxed text-slate-500 dark:text-slate-400 font-light mb-4">
                            {t(`cases.${c.key}.desc` as any)}
                        </p>
                        <div class="pcard-foot">
                            <span class="pcard-metric">
                                <span class="material-symbols-outlined text-[1rem]">trending_up</span>
                                {t(`cases.${c.key}.metric` as any)}
                            </span>
                            <span class="pcard-tags">
                                {c.stack.map((s) => (
                                    <i>{s}</i>
                                ))}
                            </span>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .pcard {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 18px 18px 16px;
        border-radius: 16px;
        border: 1px solid rgba(100, 116, 139, 0.16);
        background: rgba(255, 255, 255, 0.62);
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    :global(.dark) .pcard {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(148, 163, 184, 0.14);
    }
    .pcard:hover {
        transform: translateY(-3px);
        border-color: rgba(99, 102, 241, 0.5);
        box-shadow: 0 26px 50px -30px rgba(99, 102, 241, 0.4);
    }
    .pcard-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .pcard-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(99, 102, 241, 0.1);
        flex-shrink: 0;
    }
    .pcard-motif {
        width: 110px;
        opacity: 0.85;
        transition: opacity 0.3s ease, transform 0.4s ease;
    }
    .pcard:hover .pcard-motif {
        opacity: 1;
        transform: scale(1.05);
    }
    .pcard-chip {
        align-self: flex-start;
        padding: 3px 9px;
        border-radius: 999px;
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #6366f1;
    }
    .pcard-where {
        font-size: 0.64rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 10px;
    }
    :global(.dark) .pcard-where {
        color: #64748b;
    }
    .pcard-foot {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(100, 116, 139, 0.14);
    }
    .pcard-metric {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 0.8rem;
        font-weight: 600;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }
    :global(.dark) .pcard-metric {
        color: #f1f5f9;
    }
    .pcard-metric .material-symbols-outlined {
        color: #10b981;
    }
    .pcard-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }
    .pcard-tags i {
        font-style: normal;
        font-size: 0.66rem;
        font-weight: 500;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(100, 116, 139, 0.1);
        color: #475569;
    }
    :global(.dark) .pcard-tags i {
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
    }
</style>
