---
import type { ProjectItem } from "../types";

const projects: ProjectItem[] = [
    {
        id: "p1",
        category: "Infrastructure",
        title: "Global Cloud Migration",
        description: "Reduced infrastructure costs by 40% through intelligent serverless adoption and multi-cloud orchestration.",
        imageUrl: "/images/cloud-migration.png",
        colorClass: "text-nexus-blue",
    },
    {
        id: "p2",
        category: "AI & ML",
        title: "AI Adoption for Dev Teams",
        description: "Accelerated coding velocity by 30% with context-aware AI tooling and copilot integration.",
        imageUrl: "/images/ai-dev-teams.png",
        colorClass: "text-nexus-red",
    },
    {
        id: "p3",
        category: "Security",
        title: "Security Assessment",
        description:
            "Comprehensive vulnerability analysis and penetration testing for enterprise financial platforms.",
        imageUrl: "/images/security-assessment.png",
        colorClass: "text-nexus-green",
    },
    {
        id: "p4",
        category: "Compliance",
        title: "ISO & PCI Certification",
        description:
            "Guided a major payment processor through ISO 27001 and PCI DSS certification in record time.",
        imageUrl: "/images/iso-pci-project.png",
        colorClass: "text-nexus-yellow",
    },
    {
        id: "p5",
        category: "DRP",
        title: "Disaster Recovery Strategy",
        description:
            "Designed and implemented a multi-region disaster recovery plan ensuring 99.99% uptime for a fintech platform.",
        imageUrl: "/images/drp-project.png",
        colorClass: "text-nexus-green",
    },
    {
        id: "p6",
        category: "AI Agents",
        title: "Autonomous AI Agents",
        description:
            "Deployed intelligent AI agents that automate complex workflows, reducing operational overhead by 60%.",
        imageUrl: "/images/ai-agents-project.png",
        colorClass: "text-nexus-purple",
    },
];
---

<section class="py-32 bg-nexus-gray-soft dark:bg-slate-950 transition-colors duration-300" id="projects">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="mb-16 flex justify-between items-end reveal">
            <div>
                <h2 class="text-sm font-bold tracking-[0.3em] uppercase text-nexus-purple mb-4">
                    Case Studies
                </h2>
                <p class="text-3xl md:text-4xl font-display font-medium text-slate-900 dark:text-white transition-colors">
                    Featured Projects
                </p>
            </div>
            <div class="hidden md:flex gap-4">
                <button
                    id="scroll-left"
                    aria-label="Scroll projects left"
                    class="w-12 h-12 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-400 dark:text-slate-500 hover:border-slate-900 dark:hover:border-white hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
                >
                    <span class="material-symbols-outlined">west</span>
                </button>
                <button
                    id="scroll-right"
                    aria-label="Scroll projects right"
                    class="w-12 h-12 rounded-full border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-400 dark:text-slate-500 hover:border-slate-900 dark:hover:border-white hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
                >
                    <span class="material-symbols-outlined">east</span>
                </button>
            </div>
        </div>

        <div id="projects-scroll" class="overflow-x-auto hide-scrollbar snap-x snap-mandatory">
            <div class="flex gap-6">
                {
                    projects.map((project) => (
                        <div class="snap-center flex-shrink-0 w-[260px] md:w-[320px] bg-white dark:bg-slate-900 rounded-2xl overflow-hidden shadow-sm dark:shadow-none border border-gray-100 dark:border-slate-800 group hover:shadow-xl dark:hover:border-nexus-blue/30 transition-all duration-500">
                            <div class="relative h-[180px] md:h-[200px] overflow-hidden">
                                <img
                                    src={project.imageUrl}
                                    alt={project.title}
                                    loading="lazy"
                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                />
                                <!-- Hover overlay -->
                                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-5">
                                    <span class={`text-[0.65rem] uppercase tracking-widest font-bold ${project.colorClass} mb-1.5 block`}>
                                        {project.category}
                                    </span>
                                    <h3 class="text-base font-bold text-white mb-2 leading-snug">
                                        {project.title}
                                    </h3>
                                    <p class="text-xs text-slate-300 font-light leading-relaxed">
                                        {project.description}
                                    </p>
                                </div>
                            </div>
                            <div class="p-5">
                                <span
                                    class={`text-[0.65rem] uppercase tracking-widest font-bold ${project.colorClass} mb-1.5 block`}
                                >
                                    {project.category}
                                </span>
                                <h3 class="text-base font-bold text-slate-900 dark:text-white tracking-tight transition-colors leading-snug">
                                    {project.title}
                                </h3>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    const scrollContainer = document.getElementById("projects-scroll");
    const scrollLeft = document.getElementById("scroll-left");
    const scrollRight = document.getElementById("scroll-right");

    if (scrollContainer && scrollLeft && scrollRight) {
        scrollLeft.addEventListener("click", () => {
            scrollContainer.scrollTo({
                left: scrollContainer.scrollLeft - scrollContainer.clientWidth,
                behavior: "smooth",
            });
        });

        scrollRight.addEventListener("click", () => {
            scrollContainer.scrollTo({
                left: scrollContainer.scrollLeft + scrollContainer.clientWidth,
                behavior: "smooth",
            });
        });
    }
</script>
