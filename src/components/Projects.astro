---
// Projects — compact case studies in the deck's language: icon + mesh motif, vertical chip,
// one-line outcome, the metric, the stack. No photography.
import Motif from "./Motif.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);

type Vertical = "infra" | "security" | "pod";
const motifFor: Record<Vertical, "grid" | "ring" | "cluster"> = {
    infra: "grid",
    security: "ring",
    pod: "cluster",
};
const colorFor: Record<Vertical, string> = {
    infra: "text-nexus-blue",
    security: "text-nexus-purple",
    pod: "text-nexus-amber",
};

const projects: { key: string; vertical: Vertical; icon: string; stack: string[] }[] = [
    { key: "p1", vertical: "pod", icon: "smart_toy", stack: ["LangChain", "GPT-4", "Vector DB"] },
    { key: "p2", vertical: "pod", icon: "terminal", stack: ["Copilot", "Claude", "CI/CD"] },
    { key: "p3", vertical: "infra", icon: "cloud_sync", stack: ["AWS", "Terraform", "K8s"] },
    { key: "p4", vertical: "security", icon: "shield", stack: ["Pentest", "SIEM", "WAF"] },
    { key: "p5", vertical: "security", icon: "verified", stack: ["ISO 27001", "PCI DSS"] },
    { key: "p6", vertical: "security", icon: "sync_alt", stack: ["Multi-region", "AWS", "RTO<1h"] },
];
---

<section id="projects" class="relative py-28 lg:py-36 overflow-hidden">
    <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
    <div
        class="absolute -bottom-40 left-[-10%] w-[44%] h-[44%] rounded-full blur-[140px] bg-nexus-blue/6 dark:bg-nexus-blue/10 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
        <div class="reveal mb-12 lg:mb-14 flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
                <div class="nx-kicker mb-5">{t("projects.badge")}</div>
                <h2
                    class="font-display font-extrabold tracking-[-0.035em] leading-[0.98] text-4xl md:text-5xl text-slate-900 dark:text-white mb-4"
                >
                    {t("projects.title")}
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg font-light leading-relaxed">
                    {t("projects.lead")}
                </p>
            </div>
        </div>

        <div id="bento-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {
                projects.map((p) => (
                    <article class="bento-card pcard group">
                        <div class="pcard-top">
                            <span class={`pcard-icon ${colorFor[p.vertical]}`}>
                                <span class="material-symbols-outlined text-[1.35rem]">{p.icon}</span>
                            </span>
                            <span class={`pcard-motif ${colorFor[p.vertical]}`}>
                                <Motif kind={motifFor[p.vertical]} />
                            </span>
                        </div>
                        <span class="nx-kicker pcard-chip">{t(`hero.intent.${p.vertical}` as any)}</span>
                        <h3 class="font-display font-bold text-slate-900 dark:text-white text-[1.12rem] tracking-tight leading-snug mt-2 mb-2">
                            {t(`projects.${p.key}.title` as any)}
                        </h3>
                        <p class="text-[0.86rem] leading-relaxed text-slate-500 dark:text-slate-400 font-light mb-4">
                            {t(`projects.${p.key}.desc` as any)}
                        </p>
                        <div class="pcard-foot">
                            <span class="pcard-metric">
                                <span class="material-symbols-outlined text-[1rem]">trending_up</span>
                                {t(`projects.${p.key}.metric` as any)}
                            </span>
                            <span class="pcard-tags">
                                {p.stack.map((s) => (
                                    <i>{s}</i>
                                ))}
                            </span>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .pcard {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 18px 18px 16px;
        border-radius: 16px;
        border: 1px solid rgba(100, 116, 139, 0.16);
        background: rgba(255, 255, 255, 0.62);
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    :global(.dark) .pcard {
        background: rgba(15, 23, 42, 0.5);
        border-color: rgba(148, 163, 184, 0.14);
    }
    .pcard:hover {
        transform: translateY(-3px);
        border-color: rgba(99, 102, 241, 0.5);
        box-shadow: 0 26px 50px -30px rgba(99, 102, 241, 0.4);
    }
    .pcard-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .pcard-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(99, 102, 241, 0.1);
        flex-shrink: 0;
    }
    .pcard-motif {
        width: 110px;
        opacity: 0.85;
        transition: opacity 0.3s ease, transform 0.4s ease;
    }
    .pcard:hover .pcard-motif {
        opacity: 1;
        transform: scale(1.05);
    }
    .pcard-chip {
        align-self: flex-start;
        padding: 3px 9px;
        border-radius: 999px;
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #6366f1;
    }
    .pcard-foot {
        margin-top: auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px 12px;
        padding-top: 12px;
        border-top: 1px solid rgba(100, 116, 139, 0.14);
    }
    .pcard-metric {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 0.8rem;
        font-weight: 600;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }
    :global(.dark) .pcard-metric {
        color: #f1f5f9;
    }
    .pcard-metric .material-symbols-outlined {
        color: #10b981;
    }
    .pcard-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }
    .pcard-tags i {
        font-style: normal;
        font-size: 0.66rem;
        font-weight: 500;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(100, 116, 139, 0.1);
        color: #475569;
    }
    :global(.dark) .pcard-tags i {
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
    }
</style>
