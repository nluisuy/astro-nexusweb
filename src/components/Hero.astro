---

<section class="relative pt-40 pb-24 lg:pt-64 lg:pb-56 overflow-hidden">
    <!-- Particle Canvas Background -->
    <canvas id="hero-particles" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>

    <!-- Background Decor -->
    <div class="absolute top-0 left-0 w-full h-full opacity-40 pointer-events-none">
        <div
            class="absolute top-[15%] right-[10%] w-[30%] h-[30%] bg-nexus-blue/10 rounded-full blur-[80px] animate-pulse-slow"
        >
        </div>
        <div
            class="absolute bottom-[20%] left-[15%] w-[40%] h-[40%] bg-nexus-purple/5 rounded-full blur-[100px] animate-pulse-slow"
            style="animation-delay: 2s;"
        >
        </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-12 z-10 text-center">
        <div class="inline-block mb-8">
            <span
                class="px-4 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-full text-[0.65rem] font-bold text-slate-400 tracking-[0.3em] uppercase transition-colors"
            >
                AI-Engineered Excellence
            </span>
        </div>

        <h1
            class="text-5xl md:text-8xl lg:text-9xl font-display font-bold tracking-tighter text-slate-900 dark:text-white mb-12 leading-[1] transition-colors"
        >
            <span class="text-gradient block">Future of Innovation</span>
        </h1>

        <p
            class="max-w-3xl mx-auto text-lg md:text-xl text-slate-500 dark:text-slate-400 font-light leading-relaxed mb-16 px-4 transition-colors"
        >
            We architect autonomous AI agent systems, secure cloud infrastructure, and dedicated AI Dev Pods that transform how enterprises build, scale, and innovate.
        </p>

        <div
            class="flex flex-col sm:flex-row gap-6 justify-center items-center"
        >
            <a
                href="#services"
                class="group relative px-10 py-5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full overflow-hidden transition-all hover:bg-slate-800 dark:hover:bg-slate-200 shadow-2xl shadow-slate-200 dark:shadow-none active:scale-95"
            >
                <span
                    class="relative z-10 text-sm font-bold tracking-widest uppercase flex items-center gap-3"
                >
                    Explore Capabilities

                </span>
            </a>

            <a
                href="#projects"
                class="px-10 py-5 text-sm font-bold tracking-widest uppercase text-slate-900 dark:text-white bg-white dark:bg-transparent border border-slate-200 dark:border-slate-700 rounded-full hover:border-slate-400 dark:hover:border-slate-500 transition-all flex items-center gap-2 group shadow-sm active:scale-95"
            >
                View Case Studies
                <span
                    class="material-symbols-outlined text-lg transition-transform group-hover:translate-x-1"
                    >arrow_right_alt</span
                >
            </a>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 opacity-30 animate-float"
    >
        <span class="text-[0.6rem] font-bold uppercase tracking-widest text-slate-400">Scroll</span>
        <div class="w-px h-12 bg-gradient-to-b from-slate-400 to-transparent"></div>
    </div>
</section>

<script>
    // Orchestration Pulse Animation
    const canvas = document.getElementById('hero-particles') as HTMLCanvasElement;
    
    if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
            let animationId: number;
            let particles: Particle[] = [];
            let pulses: Pulse[] = [];
            
            // Mouse interaction state
            const mouse = { x: -1000, y: -1000, radius: 200 };

            class Particle {
                x: number;
                y: number;
                baseX: number;
                baseY: number;
                vx: number;
                vy: number;
                size: number;
                opacity: number;
                connections: Particle[];

                constructor(width: number, height: number) {
                    this.x = Math.random() * width;
                    this.y = Math.random() * height;
                    this.baseX = this.x;
                    this.baseY = this.y;
                    this.vx = (Math.random() - 0.5) * 0.3;
                    this.vy = (Math.random() - 0.5) * 0.3;
                    this.size = Math.random() * 2 + 1;
                    this.opacity = Math.random() * 0.6 + 0.2;
                    this.connections = [];
                }

                update(width: number, height: number) {
                    // Normal subtle movement
                    this.baseX += this.vx;
                    this.baseY += this.vy;

                    // Bounce off walls
                    if (this.baseX < 0 || this.baseX > width) this.vx *= -1;
                    if (this.baseY < 0 || this.baseY > height) this.vy *= -1;

                    // Mouse interaction (subtle attraction/repulsion)
                    const dx = mouse.x - this.baseX;
                    const dy = mouse.y - this.baseY;
                    const distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < mouse.radius) {
                        const forceDirectionX = dx / distance;
                        const forceDirectionY = dy / distance;
                        const force = (mouse.radius - distance) / mouse.radius;
                        // Move slightly away from mouse
                        this.x = this.baseX - forceDirectionX * force * 30;
                        this.y = this.baseY - forceDirectionY * force * 30;
                    } else {
                        // Return to base position smoothly
                        this.x += (this.baseX - this.x) * 0.1;
                        this.y += (this.baseY - this.y) * 0.1;
                    }
                }
            }

            class Pulse {
                from: Particle;
                to: Particle;
                progress: number;
                speed: number;
                color: string;

                constructor(from: Particle, to: Particle, darkTheme: boolean) {
                    this.from = from;
                    this.to = to;
                    this.progress = 0;
                    this.speed = Math.random() * 0.02 + 0.01; // Travel speed
                    
                    // Choose one of the 3 brand gradient colors for the pulse
                    const colors = darkTheme 
                        ? ['139, 92, 246', '59, 130, 246', '16, 185, 129'] // Bright variants for dark mode
                        : ['109, 40, 217', '37, 99, 235', '5, 150, 105'];  // Slightly darker for light mode
                    
                    this.color = colors[Math.floor(Math.random() * colors.length)];
                }

                update() {
                    this.progress += this.speed;
                    return this.progress >= 1; // Return true if finished
                }

                draw(ctx: CanvasRenderingContext2D) {
                    // Calculate current position
                    const x = this.from.x + (this.to.x - this.from.x) * this.progress;
                    const y = this.from.y + (this.to.y - this.from.y) * this.progress;

                    // Draw the core bright dot
                    ctx.beginPath();
                    ctx.arc(x, y, 2.5, 0, Math.PI * 2);
                    ctx.fillStyle = `rgb(${this.color})`;
                    ctx.fill();

                    // Draw the glow
                    ctx.beginPath();
                    ctx.arc(x, y, 8, 0, Math.PI * 2);
                    const gradient = ctx.createRadialGradient(x, y, 0, x, y, 8);
                    gradient.addColorStop(0, `rgba(${this.color}, 0.8)`);
                    gradient.addColorStop(1, `rgba(${this.color}, 0)`);
                    ctx.fillStyle = gradient;
                    ctx.fill();
                }
            }

            function resize() {
                canvas.width = canvas.offsetWidth * window.devicePixelRatio;
                canvas.height = canvas.offsetHeight * window.devicePixelRatio;
                ctx!.scale(window.devicePixelRatio, window.devicePixelRatio);
                createParticles(); // Recreate on resize to spread evenly
            }

            function createParticles() {
                const count = Math.min(100, Math.floor(canvas.offsetWidth * canvas.offsetHeight / 12000));
                particles = [];
                for (let i = 0; i < count; i++) {
                    particles.push(new Particle(canvas.offsetWidth, canvas.offsetHeight));
                }
            }

            function isDark() {
                return document.documentElement.classList.contains('dark');
            }

            function draw() {
                ctx!.clearRect(0, 0, canvas.offsetWidth, canvas.offsetHeight);
                const dark = isDark();
                
                // Base grid colors
                const nodeColor = dark ? '148, 163, 184' : '100, 116, 139'; // slate-400 / slate-500
                const lineColor = dark ? '71, 85, 105' : '203, 213, 225'; // slate-600 / slate-300

                // 1. Update all particles and determine connections
                for (let i = 0; i < particles.length; i++) {
                    particles[i].update(canvas.offsetWidth, canvas.offsetHeight);
                    particles[i].connections = []; // Reset fast lookup array
                }

                // 2. Draw static connections and occasionally spawn pulses
                ctx!.lineWidth = 1;
                for (let i = 0; i < particles.length; i++) {
                    const p1 = particles[i];
                    
                    for (let j = i + 1; j < particles.length; j++) {
                        const p2 = particles[j];
                        const dx = p1.x - p2.x;
                        const dy = p1.y - p2.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        if (dist < 180) { // Connection distance
                            // Store connection
                            p1.connections.push(p2);
                            p2.connections.push(p1);

                            // Draw baseline connection
                            ctx!.beginPath();
                            ctx!.moveTo(p1.x, p1.y);
                            ctx!.lineTo(p2.x, p2.y);
                            
                            // Make lines near mouse slightly more visible
                            const mouseDist = Math.sqrt(Math.pow(mouse.x - (p1.x+p2.x)/2, 2) + Math.pow(mouse.y - (p1.y+p2.y)/2, 2));
                            const mouseBoost = mouseDist < mouse.radius ? 0.15 : 0;
                            
                            ctx!.strokeStyle = `rgba(${lineColor}, ${(0.15 + mouseBoost) * (1 - dist / 180)})`;
                            ctx!.stroke();

                            // Randomly spawn a pulse (simulating data transfer / agent intent)
                            // Higher chance if near mouse interaction
                            const spawnChance = mouseBoost > 0 ? 0.005 : 0.0005;
                            if (Math.random() < spawnChance && pulses.length < 15) {
                                pulses.push(new Pulse(p1, p2, dark));
                            }
                        }
                    }
                    
                    // 3. Draw the nodes
                    ctx!.beginPath();
                    ctx!.arc(p1.x, p1.y, p1.size, 0, Math.PI * 2);
                    
                    // Highlight nodes near mouse
                    const distToMouse = Math.sqrt(Math.pow(p1.x - mouse.x, 2) + Math.pow(p1.y - mouse.y, 2));
                    if (distToMouse < mouse.radius/2) {
                        ctx!.fillStyle = `rgba(${dark ? '255,255,255' : '15,23,42'}, ${(1 - distToMouse/(mouse.radius/2))})`;
                        // Subtle glow
                        ctx!.shadowBlur = 10;
                        ctx!.shadowColor = dark ? 'rgba(255,255,255,0.5)' : 'rgba(0,0,0,0.2)';
                    } else {
                        ctx!.fillStyle = `rgba(${nodeColor}, ${p1.opacity})`;
                        ctx!.shadowBlur = 0;
                    }
                    
                    ctx!.fill();
                    ctx!.shadowBlur = 0; // reset
                }

                // 4. Update and draw existing pulses
                for (let i = pulses.length - 1; i >= 0; i--) {
                    const isFinished = pulses[i].update();
                    pulses[i].draw(ctx!);
                    
                    if (isFinished) {
                        // Pulse finished traveling
                        const endNode = pulses[i].to;
                        pulses.splice(i, 1);
                        
                        // Small chance to propagate to the next node (chain reaction)
                        if (Math.random() < 0.3 && endNode.connections.length > 0 && pulses.length < 20) {
                            // Pick a random connected node that isn't the one we just came from
                            const validTargets = endNode.connections;
                            if (validTargets.length > 0) {
                                const nextNode = validTargets[Math.floor(Math.random() * validTargets.length)];
                                pulses.push(new Pulse(endNode, nextNode, dark));
                            }
                        }
                    }
                }

                animationId = requestAnimationFrame(draw);
            }

            // Initialization
            resize();
            draw();

            // Event Listeners
            window.addEventListener('resize', resize);
            
            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                mouse.x = e.clientX - rect.left;
                mouse.y = e.clientY - rect.top;
            });

            canvas.addEventListener('mouseleave', () => {
                mouse.x = -1000;
                mouse.y = -1000;
            });

            // Cleanup on Astro page transition
            document.addEventListener('astro:before-swap', () => {
                cancelAnimationFrame(animationId);
                window.removeEventListener('resize', resize);
            });
        }
    }
</script>
