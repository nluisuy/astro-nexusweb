        <div class="w-px h-12 bg-gradient-to-b from-slate-400 to-transparent"></div>
    </div>
</section>

<script>
    // Neural network particle animation
    const canvas = document.getElementById('hero-particles') as HTMLCanvasElement;
    if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
            let animationId: number;
            let particles: Array<{x: number; y: number; vx: number; vy: number; size: number; opacity: number}> = [];

            function resize() {
                canvas.width = canvas.offsetWidth * window.devicePixelRatio;
                canvas.height = canvas.offsetHeight * window.devicePixelRatio;
                ctx!.scale(window.devicePixelRatio, window.devicePixelRatio);
            }

            function createParticles() {
                const count = Math.min(80, Math.floor(canvas.offsetWidth * canvas.offsetHeight / 15000));
                particles = [];
                for (let i = 0; i < count; i++) {
                    particles.push({
                        x: Math.random() * canvas.offsetWidth,
                        y: Math.random() * canvas.offsetHeight,
                        vx: (Math.random() - 0.5) * 0.4,
                        vy: (Math.random() - 0.5) * 0.4,
                        size: Math.random() * 2 + 1,
                        opacity: Math.random() * 0.5 + 0.1
                    });
                }
            }

            function isDark() {
                return document.documentElement.classList.contains('dark');
            }

            function draw() {
                ctx!.clearRect(0, 0, canvas.offsetWidth, canvas.offsetHeight);
                const dark = isDark();
                const nodeColor = dark ? '148, 163, 184' : '100, 116, 139';
                const lineColor = dark ? '148, 163, 184' : '148, 163, 184';

                // Update and draw particles
                for (const p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0 || p.x > canvas.offsetWidth) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.offsetHeight) p.vy *= -1;

                    ctx!.beginPath();
                    ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx!.fillStyle = `rgba(${nodeColor}, ${p.opacity})`;
                    ctx!.fill();
                }

                // Draw connections
                for (let i = 0; i < particles.length; i++) {
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x;
                        const dy = particles[i].y - particles[j].y;
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        if (dist < 150) {
                            ctx!.beginPath();
                            ctx!.moveTo(particles[i].x, particles[i].y);
                            ctx!.lineTo(particles[j].x, particles[j].y);
                            ctx!.strokeStyle = `rgba(${lineColor}, ${0.08 * (1 - dist / 150)})`;
                            ctx!.lineWidth = 0.5;
                            ctx!.stroke();
                        }
                    }
                }

                animationId = requestAnimationFrame(draw);
            }

            resize();
            createParticles();
            draw();

            window.addEventListener('resize', () => {
                resize();
                createParticles();
            });

            // Cleanup on navigation
            document.addEventListener('astro:before-swap', () => {
                cancelAnimationFrame(animationId);
            });
        }
    }
</script>
