---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
const isEs = lang === 'es';
---

<section class="py-32 bg-white dark:bg-slate-950 transition-colors duration-300" id="about">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="order-2 lg:order-1 reveal">
                <h2
                    class="text-4xl md:text-5xl font-display font-bold text-slate-900 dark:text-white mb-8 leading-tight transition-colors"
                >
                    {t('about.title1')} <span class="text-gradient">{t('about.title2')}</span>
                </h2>
                <p class="text-lg text-slate-500 dark:text-slate-400 font-light leading-relaxed mb-8 transition-colors">
                    {t('about.desc')}
                </p>

                <ul class="space-y-6 mb-12">
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-nexus-blue mt-1"
                            >auto_awesome_motion</span
                        >
                        <span class="text-slate-700 dark:text-slate-300 font-medium transition-colors"
                            >{t('about.point1')}</span
                        >
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-nexus-purple mt-1"
                            >shield_with_house</span
                        >
                        <span class="text-slate-700 dark:text-slate-300 font-medium transition-colors"
                            >{t('about.point2')}</span
                        >
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-nexus-green mt-1"
                            >lightbulb_circle</span
                        >
                        <span class="text-slate-700 dark:text-slate-300 font-medium transition-colors"
                            >{t('about.point3')}</span
                        >
                    </li>
                </ul>

                <a
                    href={`${isEs ? '/es' : ''}/manifesto`}
                    class="inline-flex items-center gap-2 text-sm font-bold tracking-widest uppercase text-slate-900 dark:text-white border-b-2 border-slate-900 dark:border-white pb-1 hover:text-nexus-blue dark:hover:text-nexus-blue hover:border-nexus-blue dark:hover:border-nexus-blue transition-all"
                >
                    {t('about.link')}
                </a>
            </div>

            <div class="order-1 lg:order-2 relative group reveal reveal-delay-2 h-full min-h-[400px]">
                <div class="absolute inset-0 rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-slate-100 to-slate-200 dark:from-[#0a0f18] dark:to-[#1a2235] shadow-2xl shadow-slate-200/50 dark:shadow-none border border-slate-200/50 dark:border-slate-800/50">
                    <canvas id="about-3d-canvas" class="w-full h-full object-cover"></canvas>
                    
                    <!-- Lighting overlay -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-nexus-purple/10 to-transparent pointer-events-none"></div>
                </div>

                <!-- Floating Card -->
                <div
                    class="absolute -bottom-6 -left-6 md:-bottom-10 md:-left-10 w-72 p-6 rounded-3xl backdrop-blur-xl bg-white/70 dark:bg-[#0a0f18]/80 border border-white/50 dark:border-slate-700/50 shadow-[0_8px_32px_rgba(0,0,0,0.1)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.3)] animate-float z-10"
                >
                    <div class="flex items-center gap-3 mb-3">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-nexus-green opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-nexus-green"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-900 dark:text-white"
                            >{t('about.card.title')}</span
                        >
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
                        {t('about.card.desc')}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // 3D Neural Structure Animation
    const canvas = document.getElementById('about-3d-canvas') as HTMLCanvasElement;
    
    if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
            let animationId: number;
            
            // 3D Nodes
            const nodes: {x: number, y: number, z: number}[] = [];
            const numNodes = 40;
            const radius = 1;
            
            // Generate nodes on a sphere
            for (let i = 0; i < numNodes; i++) {
                const phi = Math.acos(-1 + (2 * i) / numNodes);
                const theta = Math.sqrt(numNodes * Math.PI) * phi;
                
                nodes.push({
                    x: radius * Math.cos(theta) * Math.sin(phi),
                    y: radius * Math.sin(theta) * Math.sin(phi),
                    z: radius * Math.cos(phi)
                });
            }

            let angleX = 0;
            let angleY = 0;

            function resize() {
                const parent = canvas.parentElement;
                if (parent) {
                    canvas.width = parent.clientWidth * window.devicePixelRatio;
                    canvas.height = parent.clientHeight * window.devicePixelRatio;
                    ctx!.scale(window.devicePixelRatio, window.devicePixelRatio);
                }
            }

            function isDark() {
                return document.documentElement.classList.contains('dark');
            }

            function draw() {
                const width = canvas.width / window.devicePixelRatio;
                const height = canvas.height / window.devicePixelRatio;
                
                ctx!.clearRect(0, 0, width, height);
                
                const dark = isDark();
                const nodeColor = dark ? '139, 92, 246' : '109, 40, 217'; // Purple
                const lineColor = dark ? '59, 130, 246' : '37, 99, 235'; // Blue
                
                angleX += 0.002;
                angleY += 0.003;
                
                const cosX = Math.cos(angleX);
                const sinX = Math.sin(angleX);
                const cosY = Math.cos(angleY);
                const sinY = Math.sin(angleY);
                
                const scale = Math.min(width, height) * 0.35;
                const centerX = width / 2;
                const centerY = height / 2;
                
                // Project 3D to 2D
                const projectedNodes = nodes.map(node => {
                    // Rotate Y
                    let x = node.x * cosY - node.z * sinY;
                    let z = node.z * cosY + node.x * sinY;
                    
                    // Rotate X
                    let y = node.y * cosX - z * sinX;
                    z = z * cosX + node.y * sinX;
                    
                    // Add perspective
                    const perspective = 2.5 / (2.5 - z);
                    
                    return {
                        x: centerX + x * scale * perspective,
                        y: centerY + y * scale * perspective,
                        scale: perspective,
                        z: z
                    };
                });
                
                // Sort by Z index for proper drawing order
                const sortedPairs: {a: any, b: any, d: number, avgZ: number}[] = [];
                for (let i = 0; i < projectedNodes.length; i++) {
                    for (let j = i + 1; j < projectedNodes.length; j++) {
                        const a = projectedNodes[i];
                        const b = projectedNodes[j];
                        const d = Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));
                        if (d < scale * 1.5) {
                            sortedPairs.push({a, b, d, avgZ: (a.z + b.z) / 2});
                        }
                    }
                }
                
                sortedPairs.sort((pair1, pair2) => pair1.avgZ - pair2.avgZ);
                
                // Draw lines
                for (const p of sortedPairs) {
                    const alpha = Math.max(0.1, 0.6 - (p.d / (scale * 1.5)));
                    ctx!.beginPath();
                    ctx!.moveTo(p.a.x, p.a.y);
                    ctx!.lineTo(p.b.x, p.b.y);
                    ctx!.strokeStyle = `rgba(${lineColor}, ${alpha * (0.5 + p.avgZ/2)})`;
                    ctx!.lineWidth = 1 * ((p.a.scale + p.b.scale) / 2);
                    ctx!.stroke();
                }
                
                // Draw nodes
                projectedNodes.sort((a, b) => a.z - b.z);
                for (const node of projectedNodes) {
                    ctx!.beginPath();
                    ctx!.arc(node.x, node.y, 3 * node.scale, 0, Math.PI * 2);
                    const alpha = 0.4 + (node.z + 1) * 0.3; // fade distant nodes
                    ctx!.fillStyle = `rgba(${nodeColor}, ${alpha})`;
                    ctx!.fill();
                }
                
                animationId = requestAnimationFrame(draw);
            }

            resize();
            draw();

            window.addEventListener('resize', resize);
            
            // Cleanup on Astro page transition
            document.addEventListener('astro:before-swap', () => {
                cancelAnimationFrame(animationId);
                window.removeEventListener('resize', resize);
            });
        }
    }
</script>
