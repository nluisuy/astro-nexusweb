---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
const isEs = lang === 'es';
---

<section id="about" class="relative py-28 lg:py-36 overflow-hidden">
    <div class="nx-signal absolute top-0 inset-x-0 h-px" aria-hidden="true"></div>
    <div
        class="absolute -top-40 left-[-10%] w-[44%] h-[44%] rounded-full blur-[140px] bg-nexus-purple/6 dark:bg-nexus-purple/10 pointer-events-none"
        aria-hidden="true"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-14 lg:gap-20 items-center">
            <div class="order-2 lg:order-1 reveal">
                <div class="nx-kicker mb-5">{t('nav.about')}</div>
                <h2
                    class="font-display font-extrabold tracking-[-0.035em] leading-[0.98] text-4xl md:text-5xl lg:text-[3.6rem] text-slate-900 dark:text-white mb-5"
                >
                    {t('about.title1')} <span class="accent-grad">{t('about.title2')}</span>
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg font-light leading-relaxed max-w-2xl mb-8">
                    {t('about.desc')}
                </p>

                <ul class="ab-list">
                    <li>
                        <span class="ab-icon"><span class="material-symbols-outlined text-[1.15rem]">auto_awesome_motion</span></span>
                        <span>{t('about.point1')}</span>
                    </li>
                    <li>
                        <span class="ab-icon"><span class="material-symbols-outlined text-[1.15rem]">shield_with_house</span></span>
                        <span>{t('about.point2')}</span>
                    </li>
                    <li>
                        <span class="ab-icon"><span class="material-symbols-outlined text-[1.15rem]">lightbulb_circle</span></span>
                        <span>{t('about.point3')}</span>
                    </li>
                </ul>

                <a href={`${isEs ? '/es' : ''}/manifesto`} class="ab-link nx-mono">
                    {t('about.link')}
                    <span class="material-symbols-outlined text-[1rem]">arrow_right_alt</span>
                </a>
            </div>

            <div class="order-1 lg:order-2 relative reveal reveal-delay-2 min-h-[380px] lg:min-h-[460px]">
                <!-- the lazy-loaded three.js visual draws into this canvas (parent gives it its size) -->
                <div class="ab-visual absolute inset-0 rounded-[1.75rem] overflow-hidden">
                    <canvas id="about-3d-canvas" class="w-full h-full"></canvas>
                    <div class="absolute inset-0 bg-gradient-to-tr from-nexus-purple/10 to-transparent pointer-events-none"></div>
                </div>

                <div class="ab-card absolute -bottom-6 -left-4 md:-bottom-8 md:-left-8 w-72 z-10">
                    <div class="flex items-center gap-2.5 mb-2">
                        <span class="ab-dot"></span>
                        <span class="nx-kicker">{t('about.card.title')}</span>
                    </div>
                    <p class="text-[0.82rem] text-slate-600 dark:text-slate-300 leading-relaxed">
                        {t('about.card.desc')}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .ab-list {
        list-style: none;
        margin: 0 0 2rem;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 34rem;
    }
    .ab-list li {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.95rem;
        line-height: 1.45;
        color: #334155;
    }
    :global(.dark) .ab-list li {
        color: #cbd5e1;
    }
    .ab-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #6366f1;
        background: rgba(99, 102, 241, 0.1);
    }
    .ab-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #0f172a;
        text-decoration: none;
        border-bottom: 1px solid rgba(99, 102, 241, 0.5);
        padding-bottom: 4px;
        transition: color 0.2s, border-color 0.2s;
    }
    .ab-link:hover {
        color: #6366f1;
        border-color: #6366f1;
    }
    :global(.dark) .ab-link {
        color: #f1f5f9;
    }
    .ab-visual {
        border: 1px solid rgba(100, 116, 139, 0.18);
        background: linear-gradient(160deg, rgba(99, 102, 241, 0.08), rgba(245, 158, 66, 0.06));
    }
    :global(.dark) .ab-visual {
        border-color: rgba(148, 163, 184, 0.14);
        background: linear-gradient(160deg, rgba(99, 102, 241, 0.14), rgba(15, 23, 42, 0.6));
    }
    .ab-card {
        padding: 18px 20px;
        border-radius: 16px;
        border: 1px solid rgba(100, 116, 139, 0.18);
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(14px);
        box-shadow: 0 24px 50px -30px rgba(15, 23, 42, 0.35);
    }
    :global(.dark) .ab-card {
        background: rgba(15, 23, 42, 0.7);
        border-color: rgba(148, 163, 184, 0.16);
        box-shadow: none;
    }
    .ab-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
        animation: ab-pulse 2.6s ease-in-out infinite;
        flex-shrink: 0;
    }
    @keyframes ab-pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.4;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .ab-dot {
            animation: none;
        }
    }
</style>

<script>
    // The 3D visual depends on three.js (~500 kB raw), so it is NOT part of the
    // initial module graph. The markup above is server-rendered; three.js is
    // fetched with a dynamic import() only once the About section comes within
    // 400px of the viewport. The render loop runs only while the section is on
    // screen and the tab is visible, and prefers-reduced-motion gets a single
    // static frame instead of an animation.

    type Visual = {
        start: () => void;
        stop: () => void;
        renderOnce: () => void;
        destroy: () => void;
    };

    const section = document.getElementById('about');
    const canvas = document.getElementById('about-3d-canvas') as HTMLCanvasElement | null;

    if (section && canvas) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isDark = () => document.documentElement.classList.contains('dark');

        let visual: Visual | null = null;
        let loading: Promise<void> | null = null;
        let onScreen = false;
        let disposed = false;

        // ─── Build the scene (runs only after three.js has been fetched) ───
        async function createVisual(target: HTMLCanvasElement): Promise<Visual | null> {
            // Named imports (not a namespace) so Rollup can tree-shake the lazy chunk.
            const {
                WebGLRenderer,
                Scene,
                PerspectiveCamera,
                IcosahedronGeometry,
                MeshBasicMaterial,
                Mesh,
                BufferGeometry,
                BufferAttribute,
                PointsMaterial,
                Points,
            } = await import('three');

            let renderer: InstanceType<typeof WebGLRenderer>;
            try {
                renderer = new WebGLRenderer({ canvas: target, alpha: true, antialias: true });
            } catch {
                // No WebGL (or context creation blocked): keep the static gradient backdrop.
                return null;
            }
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const scene = new Scene();
            const camera = new PerspectiveCamera(50, 1, 0.1, 100);
            camera.position.z = 3.5;

            // Main wireframe sphere
            const sphereGeo = new IcosahedronGeometry(1.4, 3);
            const sphereMat = new MeshBasicMaterial({
                color: isDark() ? 0x8b5cf6 : 0x6d28d9,
                wireframe: true,
                transparent: true,
                opacity: 0.12,
            });
            const sphere = new Mesh(sphereGeo, sphereMat);
            scene.add(sphere);

            // Inner sphere (glass-like depth)
            const innerGeo = new IcosahedronGeometry(0.9, 2);
            const innerMat = new MeshBasicMaterial({
                color: isDark() ? 0x3b82f6 : 0x2563eb,
                wireframe: true,
                transparent: true,
                opacity: 0.06,
            });
            const innerSphere = new Mesh(innerGeo, innerMat);
            scene.add(innerSphere);

            // Orbital particles
            const orbitCount = 80;
            const orbitPositions = new Float32Array(orbitCount * 3);
            for (let i = 0; i < orbitCount; i++) {
                const r = 1.6 + Math.random() * 0.8;
                const theta = Math.random() * Math.PI * 2;
                const phi = Math.acos(2 * Math.random() - 1);
                orbitPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
                orbitPositions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
                orbitPositions[i * 3 + 2] = r * Math.cos(phi);
            }
            const orbitGeo = new BufferGeometry();
            orbitGeo.setAttribute('position', new BufferAttribute(orbitPositions, 3));
            const orbitMat = new PointsMaterial({
                color: isDark() ? 0x8b5cf6 : 0x6d28d9,
                size: 0.025,
                transparent: true,
                opacity: 0.5,
                sizeAttenuation: true,
            });
            const orbitParticles = new Points(orbitGeo, orbitMat);
            scene.add(orbitParticles);

            // Scroll-responsive rotation speed
            let scrollSpeed = 0;
            let lastScrollY = window.scrollY;
            function onScroll() {
                const currentY = window.scrollY;
                scrollSpeed = Math.abs(currentY - lastScrollY) * 0.001;
                lastScrollY = currentY;
            }

            // Animation loop. `elapsed` only advances while running, so pausing
            // off-screen does not make the spheres jump when the loop resumes.
            let elapsed = 0;
            let lastFrame = 0;
            let animationId = 0;
            let running = false;

            function renderFrame() {
                const boost = Math.min(scrollSpeed, 0.05);
                sphere.rotation.x = elapsed * 0.1 + boost * 10;
                sphere.rotation.y = elapsed * 0.15 + boost * 15;
                innerSphere.rotation.x = elapsed * -0.08;
                innerSphere.rotation.y = elapsed * -0.12;
                orbitParticles.rotation.y = elapsed * 0.03;
                orbitParticles.rotation.x = elapsed * 0.02;
                scrollSpeed *= 0.95;
                renderer.render(scene, camera);
            }

            function animate() {
                animationId = requestAnimationFrame(animate);
                const now = performance.now();
                elapsed += Math.min((now - lastFrame) / 1000, 0.1);
                lastFrame = now;
                renderFrame();
            }

            function start() {
                if (running) return;
                running = true;
                lastScrollY = window.scrollY;
                lastFrame = performance.now();
                window.addEventListener('scroll', onScroll, { passive: true });
                animate();
            }

            function stop() {
                if (!running) return;
                running = false;
                cancelAnimationFrame(animationId);
                window.removeEventListener('scroll', onScroll);
            }

            function renderOnce() {
                if (!running) renderFrame();
            }

            // Resize
            function resize() {
                const parent = target.parentElement;
                if (!parent) return;
                const w = parent.clientWidth;
                const h = parent.clientHeight;
                if (!w || !h) return;
                renderer.setSize(w, h);
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderOnce();
            }
            window.addEventListener('resize', resize);

            // Theme (dark/light) observer
            const themeObserver = new MutationObserver(() => {
                const dark = isDark();
                sphereMat.color.set(dark ? 0x8b5cf6 : 0x6d28d9);
                innerMat.color.set(dark ? 0x3b82f6 : 0x2563eb);
                orbitMat.color.set(dark ? 0x8b5cf6 : 0x6d28d9);
                renderOnce();
            });
            themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

            function destroy() {
                stop();
                themeObserver.disconnect();
                window.removeEventListener('resize', resize);
                sphereGeo.dispose();
                sphereMat.dispose();
                innerGeo.dispose();
                innerMat.dispose();
                orbitGeo.dispose();
                orbitMat.dispose();
                renderer.dispose();
            }

            resize();
            return { start, stop, renderOnce, destroy };
        }

        // ─── Orchestration: load lazily, animate only while visible ───
        function sync() {
            if (!visual) return;
            if (reduce) {
                visual.renderOnce();
            } else if (onScreen && !document.hidden) {
                visual.start();
            } else {
                visual.stop();
            }
        }

        function load() {
            if (loading) return;
            loading = createVisual(canvas!)
                .then((v) => {
                    if (!v) return;
                    if (disposed) {
                        v.destroy();
                        return;
                    }
                    visual = v;
                    sync();
                })
                .catch((err) => {
                    // Keep the gradient backdrop; the visual is decorative.
                    console.warn('[about] 3D visual unavailable:', err);
                });
        }

        // Defer the fetch to idle time so it never competes with scrolling.
        function scheduleLoad() {
            if (loading) return;
            if ('requestIdleCallback' in window) {
                (window as any).requestIdleCallback(load, { timeout: 1000 });
            } else {
                setTimeout(load, 50);
            }
        }

        // 1) Fetch three.js once the section is within 400px of the viewport.
        const nearIO = new IntersectionObserver(
            (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                    nearIO.disconnect();
                    scheduleLoad();
                }
            },
            { rootMargin: '400px 0px' }
        );
        nearIO.observe(section);

        // 2) Run the loop only while the section is actually on screen.
        const visIO = new IntersectionObserver(
            (entries) => {
                onScreen = entries.some((e) => e.isIntersecting);
                if (onScreen && !loading) load();
                sync();
            },
            { threshold: 0 }
        );
        visIO.observe(section);

        const onVisibility = () => sync();
        document.addEventListener('visibilitychange', onVisibility);

        // Cleanup on Astro page transition
        document.addEventListener(
            'astro:before-swap',
            () => {
                disposed = true;
                nearIO.disconnect();
                visIO.disconnect();
                document.removeEventListener('visibilitychange', onVisibility);
                visual?.destroy();
                visual = null;
            },
            { once: true }
        );
    }
</script>
