---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
const isEs = lang === 'es';
---

<section class="py-32 bg-white dark:bg-slate-950 transition-colors duration-300" id="about">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="order-2 lg:order-1 reveal">
                <h2
                    class="text-4xl md:text-5xl font-display font-bold text-slate-900 dark:text-white mb-8 leading-tight transition-colors"
                >
                    {t('about.title1')} <span class="text-gradient">{t('about.title2')}</span>
                </h2>
                <p class="text-lg text-slate-500 dark:text-slate-400 font-light leading-relaxed mb-8 transition-colors">
                    {t('about.desc')}
                </p>

                <ul class="space-y-6 mb-12">
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-nexus-blue mt-1"
                            >auto_awesome_motion</span
                        >
                        <span class="text-slate-700 dark:text-slate-300 font-medium transition-colors"
                            >{t('about.point1')}</span
                        >
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-nexus-purple mt-1"
                            >shield_with_house</span
                        >
                        <span class="text-slate-700 dark:text-slate-300 font-medium transition-colors"
                            >{t('about.point2')}</span
                        >
                    </li>
                    <li class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-nexus-green mt-1"
                            >lightbulb_circle</span
                        >
                        <span class="text-slate-700 dark:text-slate-300 font-medium transition-colors"
                            >{t('about.point3')}</span
                        >
                    </li>
                </ul>

                <a
                    href={`${isEs ? '/es' : ''}/manifesto`}
                    class="inline-flex items-center gap-2 text-sm font-bold tracking-widest uppercase text-slate-900 dark:text-white border-b-2 border-slate-900 dark:border-white pb-1 hover:text-nexus-blue dark:hover:text-nexus-blue hover:border-nexus-blue dark:hover:border-nexus-blue transition-all"
                >
                    {t('about.link')}
                </a>
            </div>

            <div class="order-1 lg:order-2 relative group reveal reveal-delay-2 h-full min-h-[400px]">
                <div class="absolute inset-0 rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-slate-100 to-slate-200 dark:from-[#0a0f18] dark:to-[#1a2235] shadow-2xl shadow-slate-200/50 dark:shadow-none border border-slate-200/50 dark:border-slate-800/50">
                    <canvas id="about-3d-canvas" class="w-full h-full object-cover"></canvas>
                    
                    <!-- Lighting overlay -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-nexus-purple/10 to-transparent pointer-events-none"></div>
                </div>

                <!-- Floating Card -->
                <div
                    class="absolute -bottom-6 -left-6 md:-bottom-10 md:-left-10 w-72 p-6 rounded-3xl backdrop-blur-xl bg-white/70 dark:bg-[#0a0f18]/80 border border-white/50 dark:border-slate-700/50 shadow-[0_8px_32px_rgba(0,0,0,0.1)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.3)] animate-float z-10"
                >
                    <div class="flex items-center gap-3 mb-3">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-nexus-green opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-nexus-green"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-900 dark:text-white"
                            >{t('about.card.title')}</span
                        >
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
                        {t('about.card.desc')}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // The 3D visual depends on three.js (~500 kB raw), so it is NOT part of the
    // initial module graph. The markup above is server-rendered; three.js is
    // fetched with a dynamic import() only once the About section comes within
    // 400px of the viewport. The render loop runs only while the section is on
    // screen and the tab is visible, and prefers-reduced-motion gets a single
    // static frame instead of an animation.

    type Visual = {
        start: () => void;
        stop: () => void;
        renderOnce: () => void;
        destroy: () => void;
    };

    const section = document.getElementById('about');
    const canvas = document.getElementById('about-3d-canvas') as HTMLCanvasElement | null;

    if (section && canvas) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isDark = () => document.documentElement.classList.contains('dark');

        let visual: Visual | null = null;
        let loading: Promise<void> | null = null;
        let onScreen = false;
        let disposed = false;

        // ─── Build the scene (runs only after three.js has been fetched) ───
        async function createVisual(target: HTMLCanvasElement): Promise<Visual | null> {
            // Named imports (not a namespace) so Rollup can tree-shake the lazy chunk.
            const {
                WebGLRenderer,
                Scene,
                PerspectiveCamera,
                IcosahedronGeometry,
                MeshBasicMaterial,
                Mesh,
                BufferGeometry,
                BufferAttribute,
                PointsMaterial,
                Points,
            } = await import('three');

            let renderer: InstanceType<typeof WebGLRenderer>;
            try {
                renderer = new WebGLRenderer({ canvas: target, alpha: true, antialias: true });
            } catch {
                // No WebGL (or context creation blocked): keep the static gradient backdrop.
                return null;
            }
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const scene = new Scene();
            const camera = new PerspectiveCamera(50, 1, 0.1, 100);
            camera.position.z = 3.5;

            // Main wireframe sphere
            const sphereGeo = new IcosahedronGeometry(1.4, 3);
            const sphereMat = new MeshBasicMaterial({
                color: isDark() ? 0x8b5cf6 : 0x6d28d9,
                wireframe: true,
                transparent: true,
                opacity: 0.12,
            });
            const sphere = new Mesh(sphereGeo, sphereMat);
            scene.add(sphere);

            // Inner sphere (glass-like depth)
            const innerGeo = new IcosahedronGeometry(0.9, 2);
            const innerMat = new MeshBasicMaterial({
                color: isDark() ? 0x3b82f6 : 0x2563eb,
                wireframe: true,
                transparent: true,
                opacity: 0.06,
            });
            const innerSphere = new Mesh(innerGeo, innerMat);
            scene.add(innerSphere);

            // Orbital particles
            const orbitCount = 80;
            const orbitPositions = new Float32Array(orbitCount * 3);
            for (let i = 0; i < orbitCount; i++) {
                const r = 1.6 + Math.random() * 0.8;
                const theta = Math.random() * Math.PI * 2;
                const phi = Math.acos(2 * Math.random() - 1);
                orbitPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
                orbitPositions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
                orbitPositions[i * 3 + 2] = r * Math.cos(phi);
            }
            const orbitGeo = new BufferGeometry();
            orbitGeo.setAttribute('position', new BufferAttribute(orbitPositions, 3));
            const orbitMat = new PointsMaterial({
                color: isDark() ? 0x8b5cf6 : 0x6d28d9,
                size: 0.025,
                transparent: true,
                opacity: 0.5,
                sizeAttenuation: true,
            });
            const orbitParticles = new Points(orbitGeo, orbitMat);
            scene.add(orbitParticles);

            // Scroll-responsive rotation speed
            let scrollSpeed = 0;
            let lastScrollY = window.scrollY;
            function onScroll() {
                const currentY = window.scrollY;
                scrollSpeed = Math.abs(currentY - lastScrollY) * 0.001;
                lastScrollY = currentY;
            }

            // Animation loop. `elapsed` only advances while running, so pausing
            // off-screen does not make the spheres jump when the loop resumes.
            let elapsed = 0;
            let lastFrame = 0;
            let animationId = 0;
            let running = false;

            function renderFrame() {
                const boost = Math.min(scrollSpeed, 0.05);
                sphere.rotation.x = elapsed * 0.1 + boost * 10;
                sphere.rotation.y = elapsed * 0.15 + boost * 15;
                innerSphere.rotation.x = elapsed * -0.08;
                innerSphere.rotation.y = elapsed * -0.12;
                orbitParticles.rotation.y = elapsed * 0.03;
                orbitParticles.rotation.x = elapsed * 0.02;
                scrollSpeed *= 0.95;
                renderer.render(scene, camera);
            }

            function animate() {
                animationId = requestAnimationFrame(animate);
                const now = performance.now();
                elapsed += Math.min((now - lastFrame) / 1000, 0.1);
                lastFrame = now;
                renderFrame();
            }

            function start() {
                if (running) return;
                running = true;
                lastScrollY = window.scrollY;
                lastFrame = performance.now();
                window.addEventListener('scroll', onScroll, { passive: true });
                animate();
            }

            function stop() {
                if (!running) return;
                running = false;
                cancelAnimationFrame(animationId);
                window.removeEventListener('scroll', onScroll);
            }

            function renderOnce() {
                if (!running) renderFrame();
            }

            // Resize
            function resize() {
                const parent = target.parentElement;
                if (!parent) return;
                const w = parent.clientWidth;
                const h = parent.clientHeight;
                if (!w || !h) return;
                renderer.setSize(w, h);
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderOnce();
            }
            window.addEventListener('resize', resize);

            // Theme (dark/light) observer
            const themeObserver = new MutationObserver(() => {
                const dark = isDark();
                sphereMat.color.set(dark ? 0x8b5cf6 : 0x6d28d9);
                innerMat.color.set(dark ? 0x3b82f6 : 0x2563eb);
                orbitMat.color.set(dark ? 0x8b5cf6 : 0x6d28d9);
                renderOnce();
            });
            themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

            function destroy() {
                stop();
                themeObserver.disconnect();
                window.removeEventListener('resize', resize);
                sphereGeo.dispose();
                sphereMat.dispose();
                innerGeo.dispose();
                innerMat.dispose();
                orbitGeo.dispose();
                orbitMat.dispose();
                renderer.dispose();
            }

            resize();
            return { start, stop, renderOnce, destroy };
        }

        // ─── Orchestration: load lazily, animate only while visible ───
        function sync() {
            if (!visual) return;
            if (reduce) {
                visual.renderOnce();
            } else if (onScreen && !document.hidden) {
                visual.start();
            } else {
                visual.stop();
            }
        }

        function load() {
            if (loading) return;
            loading = createVisual(canvas!)
                .then((v) => {
                    if (!v) return;
                    if (disposed) {
                        v.destroy();
                        return;
                    }
                    visual = v;
                    sync();
                })
                .catch((err) => {
                    // Keep the gradient backdrop; the visual is decorative.
                    console.warn('[about] 3D visual unavailable:', err);
                });
        }

        // Defer the fetch to idle time so it never competes with scrolling.
        function scheduleLoad() {
            if (loading) return;
            if ('requestIdleCallback' in window) {
                (window as any).requestIdleCallback(load, { timeout: 1000 });
            } else {
                setTimeout(load, 50);
            }
        }

        // 1) Fetch three.js once the section is within 400px of the viewport.
        const nearIO = new IntersectionObserver(
            (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                    nearIO.disconnect();
                    scheduleLoad();
                }
            },
            { rootMargin: '400px 0px' }
        );
        nearIO.observe(section);

        // 2) Run the loop only while the section is actually on screen.
        const visIO = new IntersectionObserver(
            (entries) => {
                onScreen = entries.some((e) => e.isIntersecting);
                if (onScreen && !loading) load();
                sync();
            },
            { threshold: 0 }
        );
        visIO.observe(section);

        const onVisibility = () => sync();
        document.addEventListener('visibilitychange', onVisibility);

        // Cleanup on Astro page transition
        document.addEventListener(
            'astro:before-swap',
            () => {
                disposed = true;
                nearIO.disconnect();
                visIO.disconnect();
                document.removeEventListener('visibilitychange', onVisibility);
                visual?.destroy();
                visual = null;
            },
            { once: true }
        );
    }
</script>
