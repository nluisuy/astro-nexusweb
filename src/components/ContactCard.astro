---
// ContactCard — personal digital business card (nexusinnova.com/luis).
// One card per person: data lives in `person`, copy in `t` per language.
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";

interface Props {
    lang: "en" | "es";
}
const { lang } = Astro.props;

const person = {
    name: "Luis Nuñez",
    company: "NexusInnova",
    location: "Philadelphia, PA · USA",
    phoneDisplay: "+1 484 795 8589",
    phoneE164: "+14847958589",
    email: "luis@nexusinnova.com",
    web: "nexusinnova.com",
    linkedin: "lrnuy",
    vcf: "/luis.vcf",
    qr: "/images/luis-qr.png",
};

const copy = {
    en: {
        role: "Founder",
        save: "Save contact",
        showQr: "Show QR",
        hideQr: "Hide QR",
        call: "Call",
        email: "Email",
        qrHelp: "Point your phone camera at the code to add Luis to your contacts. No app or internet needed.",
        mobile: "Mobile · WhatsApp",
        website: "Website",
        copy: "Copy",
        copied: "Copied",
        tagline: "AI agents · Cloud infrastructure · Cybersecurity",
        back: "Visit nexusinnova.com",
        other: "Español",
        otherHref: "/es/luis",
    },
    es: {
        role: "Fundador",
        save: "Guardar contacto",
        showQr: "Mostrar QR",
        hideQr: "Ocultar QR",
        call: "Llamar",
        email: "Email",
        qrHelp: "Apuntá la cámara del celular al código para agregar a Luis a tus contactos. Sin apps ni internet.",
        mobile: "Celular · WhatsApp",
        website: "Sitio web",
        copy: "Copiar",
        copied: "Copiado",
        tagline: "Agentes de IA · Infraestructura cloud · Ciberseguridad",
        back: "Visitar nexusinnova.com",
        other: "English",
        otherHref: "/luis",
    },
}[lang];

const rows = [
    { k: copy.mobile, v: person.phoneDisplay, copyValue: person.phoneE164, href: null },
    { k: "Email", v: person.email, copyValue: person.email, href: `mailto:${person.email}` },
    { k: copy.website, v: person.web, copyValue: `https://${person.web}`, href: `https://${person.web}` },
    { k: "LinkedIn", v: `linkedin.com/in/${person.linkedin}`, copyValue: `https://www.linkedin.com/in/${person.linkedin}`, href: `https://www.linkedin.com/in/${person.linkedin}` },
];
---

<main class="cc-page">
    <article class="cc-card" aria-label={`${person.name} — ${copy.role}, ${person.company}`}>
        <div class="cc-stripe" aria-hidden="true"></div>

        <header class="cc-head">
            <a href={lang === "es" ? "/es/" : "/"} class="cc-logo" aria-label="Nexus Digital Innovations">
                <Image src={logo} alt="Nexus Digital Innovations" width={168} height={48} loading="eager" />
            </a>
            <div>
                <p class="nx-kicker">{copy.role}</p>
                <h1 class="cc-name">{person.name}</h1>
                <p class="cc-meta"><strong>{person.company}</strong><span aria-hidden="true">·</span>{person.location}</p>
            </div>
        </header>

        <div class="cc-actions">
            <a class="cc-act cc-act--primary" href={person.vcf} download="Luis_Nunez_NexusInnova.vcf">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M19 8v6M16 11h6"/></svg>
                <span>{copy.save}</span>
            </a>
            <button class="cc-act" type="button" id="cc-qr-btn" aria-expanded="false" aria-controls="cc-qr" data-show={copy.showQr} data-hide={copy.hideQr}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v3M17 20h3M14 20h.01"/></svg>
                <span id="cc-qr-label">{copy.showQr}</span>
            </button>
            <a class="cc-act" href={`https://wa.me/${person.phoneE164.replace("+", "")}`} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.6L3 21z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2L9 9.5z"/></svg>
                <span>WhatsApp</span>
            </a>
            <a class="cc-act" href={`tel:${person.phoneE164}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
                <span>{copy.call}</span>
            </a>
        </div>

        <section class="cc-qr" id="cc-qr" hidden>
            <img src={person.qr} alt={`QR code — ${person.name} contact card`} width="300" height="300" loading="lazy" />
            <p>{copy.qrHelp}</p>
        </section>

        <dl class="cc-list">
            {rows.map((r) => (
                <div class="cc-row">
                    <div class="min-w-0">
                        <dt>{r.k}</dt>
                        <dd>{r.href ? <a href={r.href} target={r.href.startsWith("http") ? "_blank" : undefined} rel="noopener">{r.v}</a> : r.v}</dd>
                    </div>
                    <button type="button" class="cc-copy" data-copy={r.copyValue} data-label={copy.copy} data-done={copy.copied}>{copy.copy}</button>
                </div>
            ))}
        </dl>
    </article>

    <footer class="cc-foot">
        <span>{copy.tagline}</span>
        <nav class="cc-links">
            <a href={copy.otherHref} hreflang={lang === "es" ? "en" : "es"}>{copy.other}</a>
            <a href={lang === "es" ? "/es/" : "/"}>{copy.back}</a>
        </nav>
    </footer>
</main>

<script>
    const qr = document.getElementById("cc-qr");
    const btn = document.getElementById("cc-qr-btn");
    const label = document.getElementById("cc-qr-label");
    const setQr = (open: boolean) => {
        if (!qr || !btn || !label) return;
        qr.hidden = !open;
        btn.setAttribute("aria-expanded", String(open));
        label.textContent = open ? btn.dataset.hide || "" : btn.dataset.show || "";
        if (open) qr.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };
    btn?.addEventListener("click", () => setQr(qr?.hidden ?? true));
    if (location.hash === "#qr") setQr(true);

    document.querySelectorAll<HTMLButtonElement>(".cc-copy").forEach((b) => {
        b.addEventListener("click", async () => {
            const text = b.dataset.copy || "";
            let ok = false;
            try {
                await navigator.clipboard.writeText(text);
                ok = true;
            } catch {
                const dd = b.parentElement?.querySelector("dd");
                if (dd) {
                    const range = document.createRange();
                    range.selectNodeContents(dd);
                    const sel = getSelection();
                    sel?.removeAllRanges();
                    sel?.addRange(range);
                    try { ok = document.execCommand("copy"); } catch { /* unsupported */ }
                }
            }
            if (ok) {
                b.textContent = b.dataset.done || "";
                b.classList.add("is-done");
                setTimeout(() => { b.textContent = b.dataset.label || ""; b.classList.remove("is-done"); }, 1600);
            }
        });
    });
</script>

<style>
    .cc-page {
        min-height: 100svh;
        display: grid;
        align-content: center;
        gap: 14px;
        max-width: 460px;
        margin: 0 auto;
        padding: 28px max(16px, env(safe-area-inset-left, 0px)) 40px max(16px, env(safe-area-inset-right, 0px));
    }
    .cc-card {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        background: #fff;
        border: 1px solid #e5e7eb;
        box-shadow: 0 18px 50px -24px rgba(15, 23, 42, 0.25);
    }
    :global(.dark) .cc-card { background: #0f172a; border-color: rgba(148, 163, 184, 0.18); box-shadow: none; }
    .cc-stripe { height: 5px; background: linear-gradient(90deg, #8b5cf6, #3b82f6, #10b981); }

    .cc-head { display: grid; gap: 18px; padding: 24px 24px 18px; }
    .cc-logo { display: block; width: 150px; max-width: 100%; }
    .cc-logo img { width: 100%; height: auto; display: block; }
    .cc-name {
        font-family: "Outfit", sans-serif;
        font-weight: 700;
        font-size: clamp(28px, 7vw, 34px);
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin: 4px 0 6px;
        color: #0f172a;
        text-wrap: balance;
    }
    :global(.dark) .cc-name { color: #f8fafc; }
    .cc-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0; font-size: 14px; color: #64748b; }
    .cc-meta strong { font-weight: 500; color: #0f172a; }
    :global(.dark) .cc-meta { color: #94a3b8; }
    :global(.dark) .cc-meta strong { color: #e2e8f0; }

    .cc-actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 0 24px 20px; }
    @media (max-width: 360px) { .cc-actions { grid-template-columns: repeat(2, 1fr); } }
    .cc-act {
        display: grid; justify-items: center; gap: 6px;
        padding: 12px 4px 10px; border-radius: 14px;
        background: #f1f5f9; color: #0f172a;
        font: 500 12px/1.2 "Inter", sans-serif; text-decoration: none; text-align: center;
        border: 1px solid transparent; cursor: pointer;
        transition: border-color 0.15s, transform 0.15s;
    }
    .cc-act svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .cc-act:hover { border-color: #3b82f6; }
    .cc-act:active { transform: scale(0.97); }
    .cc-act:focus-visible, .cc-copy:focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
    :global(.dark) .cc-act { background: #1b2740; color: #e2e8f0; }
    .cc-act--primary, :global(.dark) .cc-act--primary {
        background: linear-gradient(135deg, #8b5cf6, #3b82f6 55%, #10b981);
        color: #fff;
    }

    .cc-qr {
        display: grid; justify-items: center; gap: 14px; text-align: center;
        padding: 24px; background: #f8fafc; border-top: 1px solid #e5e7eb;
    }
    :global(.dark) .cc-qr { background: #111a2e; border-color: rgba(148, 163, 184, 0.18); }
    .cc-qr img { width: min(300px, 100%); height: auto; border-radius: 16px; background: #fff; padding: 8px; }
    .cc-qr p { margin: 0; font-size: 13px; color: #64748b; max-width: 30ch; }
    :global(.dark) .cc-qr p { color: #94a3b8; }

    .cc-list { margin: 0; }
    .cc-row {
        display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center;
        padding: 14px 24px; border-top: 1px solid #e5e7eb;
    }
    :global(.dark) .cc-row { border-color: rgba(148, 163, 184, 0.18); }
    .cc-row dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; }
    :global(.dark) .cc-row dt { color: #94a3b8; }
    .cc-row dd { margin: 0; font-size: 15px; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; color: #0f172a; }
    :global(.dark) .cc-row dd { color: #f1f5f9; }
    .cc-row dd a { color: inherit; text-decoration: none; border-bottom: 1px solid #cbd5e1; }
    :global(.dark) .cc-row dd a { border-color: rgba(148, 163, 184, 0.4); }
    .cc-copy {
        font: 500 12px/1 "Inter", sans-serif; padding: 8px 11px; border-radius: 999px;
        border: 1px solid #e5e7eb; background: #fff; color: #0f172a; cursor: pointer; white-space: nowrap;
    }
    :global(.dark) .cc-copy { background: #172238; border-color: rgba(148, 163, 184, 0.18); color: #f1f5f9; }
    .cc-copy.is-done { border-color: #10b981; color: #10b981; }

    .cc-foot {
        display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 16px;
        padding: 0 6px; font-size: 12px; color: #64748b;
    }
    .cc-links { display: flex; gap: 14px; }
    .cc-links a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
    :global(.dark) .cc-foot { color: #94a3b8; }

    @media (prefers-reduced-motion: reduce) { .cc-act { transition: none; } }
</style>
