---
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale || getLangFromUrl(Astro.url);
const t = useTranslations(lang as any);
const isEs = lang === 'es';
const langPrefix = isEs ? '/es' : '';
---

<footer class="py-24 bg-white dark:bg-slate-950 border-t border-gray-100 dark:border-slate-800 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-16 mb-20">
            <div class="col-span-1">
                <div class="flex flex-col items-start mb-8">
                    <a href="/" aria-label="Nexus Digital Innovations home">
                        <Image
                            src={logo}
                            alt="Nexus Digital Innovations"
                            height={36}
                            class="h-10 w-auto hover:scale-105 transition-transform duration-200"
                        />
                    </a>
                </div>
                <p class="text-sm text-slate-400 dark:text-slate-500 font-light leading-relaxed mb-8 transition-colors">
                    {t('footer.desc')}
                </p>
                <div class="flex space-x-6">
                    <a href="mailto:hello@nexusinnova.com" class="text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="Send us an email"
                        ><span class="material-symbols-outlined">alternate_email</span></a
                    >
                    <a href="https://www.linkedin.com/company/nexusinnovations" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="LinkedIn profile"
                        ><span class="material-symbols-outlined">hub</span></a
                    >
                </div>
            </div>

            <div>
                <h4 class="text-[0.7rem] font-bold uppercase tracking-[0.3em] text-slate-900 dark:text-white mb-8 transition-colors">
                    {t('footer.col1')}
                </h4>
                <ul class="space-y-4">
                    <li>
                        <a
                        <a
                            href={`${langPrefix}/#services`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >AI Agents</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/#services`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >AI Dev Pods</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/#services`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Infrastructure</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/#services`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Cybersecurity</a
                        >
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-[0.7rem] font-bold uppercase tracking-[0.3em] text-slate-900 dark:text-white mb-8 transition-colors">
                    {t('footer.col2')}
                </h4>
                <ul class="space-y-4">
                    <li>
                        <a
                        <a
                            href={`${langPrefix}/#about`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >{t('nav.about')}</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/manifesto`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Manifesto</a
                        >
                    </li>
                    <li>
                        <a
                            href="mailto:hello@nexusinnova.com"
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >{t('nav.contact')}</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/careers`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Careers</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/blog`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >{t('nav.insights')}</a
                        >
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="text-[0.7rem] font-bold uppercase tracking-[0.3em] text-slate-900 dark:text-white mb-8 transition-colors">
                    {t('footer.col3')}
                </h4>
                <ul class="space-y-4">
                    <li>
                        <a
                            href={`${langPrefix}/privacy`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Privacy</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/terms`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Terms</a
                        >
                    </li>
                    <li>
                        <a
                            href={`${langPrefix}/cookies`}
                            class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors"
                            >Cookies</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="flex flex-col md:flex-row justify-between items-center pt-12 border-t border-gray-100 dark:border-slate-800 transition-colors"
        >
            <p class="text-[0.7rem] text-slate-400 dark:text-slate-500 font-medium uppercase tracking-widest transition-colors">
                © {new Date().getFullYear()} {t('footer.rights')}
            </p>
            <div class="mt-8 md:mt-0 flex items-center gap-6">
                <!-- Keep English (US) as visual or actual switcher if desired -->
                <!-- <span
                    class="text-[0.7rem] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-widest cursor-pointer hover:text-slate-900 dark:hover:text-white transition-colors"
                    >English (US)</span
                > -->
                <span
                    id="back-to-top"
                    class="text-[0.7rem] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-widest cursor-pointer hover:text-slate-900 dark:hover:text-white transition-colors"
                    >{t('footer.backtotop')}</span
                >
            </div>
        </div>
    </div>
</footer>

<script>
    const backToTop = document.getElementById("back-to-top");
    if (backToTop) {
        backToTop.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });
    }
</script>
